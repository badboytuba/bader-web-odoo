<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <page name="inventory" position="after">
                <page string="Labels" name="labels">
                    <group>
                        <group colspan="4" string="CE Code">
                            <field name="on_label"/>
                        </group>
                        <group string="Manufacturer">
                            <field name="label_manufacturer"/>
                            <field name="label_made_by"/>
                            <field name="label_warning"/>
                        </group>
                        <group string="Technical Data">
                            <group>
                                <field name="tech_name_1" string="Name"/>
                                <field name="tech_name_2" string="Name"/>
                                <field name="tech_name_3" string="Name"/>
                                <field name="tech_name_4" string="Name"/>
                                <field name="tech_name_5" string="Name"/>
                            </group>
                            <group>
                                <field name="tech_value_1" string="Value"/>
                                <field name="tech_value_2" string="Value"/>
                                <field name="tech_value_3" string="Value"/>
                                <field name="tech_value_4" string="Value"/>
                                <field name="tech_value_5" string="Value"/>
                            </group>
                            <label for="tech_description"/>
                            <div colspan="4">
                                <field name="tech_description"/>
                            </div>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
