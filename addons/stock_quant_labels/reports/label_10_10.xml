<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="label_10x10_report_document">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-foreach="quants" t-as="quant">
                    <div id="label10x10">
                        <div class="l10x10-company_data">
                            <span t-field="quant.product_id.label_manufacturer"/><br/>
                        </div>
                        <div class="l10x10-barcode">
                            <img t-att-src="'/report/barcode/Code128/'+quant.product_id.barcode" height="70" width="230" alt="Barcode"/><br/>
                            <span t-field="quant.product_id.barcode"/><br/>
                        </div>
                        <div class="l10x10-serial">
                            <t t-if="quant.lot_id.name">
                                <span class="strong">SERIE: </span><br/>
                                <span class="strong" t-field="quant.lot_id.name"/>
                            </t>
                        </div>
                        <div class="l10x10-ce">
                            <img src="/stock_quant_labels/static/src/img/ce.png" alt="Logo CE"/>
                        </div>
                        <div class="l10x10-qr">
                            <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('QR', quant.product_id.barcode, 70, 70)" max-height="70" alt="Barcode"/><br/>
                        </div>
                        <div class="l10x10-product">
                            <span>REF: </span><span t-field="quant.product_id.default_code"/><br/>
                            <span t-field="quant.product_id.name"/>
                        </div>
                        <div style="page-break-after:always"/>
                    </div>
                </t>
            </div>
        </t>
    </template>
    <template id="label_10x10_report_label">
        <t t-call="web.html_container">
            <t t-set="quants" t-value="docs.env['stock.quant'].browse(quant_ids)"/>
            <t t-call="stock_quant_labels.label_10x10_report_document"/>
        </t>
    </template>
    <record id="stock_quant_labels.paperformat_label_10x10_report" model="report.paperformat">
        <field name="name">Label 10x10</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">100</field>
        <field name="page_width">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
