<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="label_70x40_report_document">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-foreach="quants" t-as="quant">
                    <div id="label70x40">
                        <div class="l70x40-logo-bader">
                            <img src="/stock_quant_labels/static/src/img/bader.png" alt="Logo Bader"/>
                        </div>
                        <div class="l70x40-ce">
                            <img src="/stock_quant_labels/static/src/img/ce.png" alt="Logo CE"/>
                        </div>
                        <table class="l70x40-table">
                            <tr>
                                <td>
                                    <div class="l70x40-serial">
                                        <t t-if="quant.lot_id.name">
                                            <span class="strong">LOTE: </span><br/>
                                            <span class="strong" t-field="quant.lot_id.name"/>
                                        </t>
                                    </div>
                                </td>
                                <td>
                                    <div class="l70x40-qr">
                                        <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('QR', quant.product_id.barcode, 60, 60)" max-height="60" alt="Barcode"/><br/>
                                    </div>
                                </td>
                                <td>
                                    <div class="l70x40-barcode">
                                        <img t-att-src="'/report/barcode/Code128/'+quant.product_id.barcode" height="50" width="120" alt="Barcode"/><br/>
                                        <span t-field="quant.product_id.barcode"/><br/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <div class="l70x40-product">
                            <span>REF: </span><span t-field="quant.product_id.default_code"/><br/>
                            <span t-field="quant.product_id.name"/>
                        </div>
                        <div style="page-break-after:always"/>
                    </div>
                </t>
            </div>
        </t>
    </template>
    <template id="label_70x40_report_label">
        <t t-call="web.html_container">
            <t t-set="quants" t-value="docs.env['stock.quant'].browse(quant_ids)"/>
            <t t-call="stock_quant_labels.label_70x40_report_document"/>
        </t>
    </template>
</odoo>
