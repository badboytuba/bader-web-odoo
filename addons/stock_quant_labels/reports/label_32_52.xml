<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="label_32x52_report_document">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-foreach="quants" t-as="quant">
                    <div id="label32x52">
                        <div class="l32x52-product">
                            <span>REF: </span><span t-field="quant.product_id.default_code"/><br/>
                            <span t-field="quant.product_id.name"/>
                        </div>
                        <div class="l32x52-serial">
                            <t t-if="quant.lot_id.name">
                                <span class="strong">LOTE: </span>
                                <span class="strong" t-field="quant.lot_id.name"/>
                            </t>
                        </div>
                        <div class="l32x52-first-logos">
                            <table>
                                <tr>
                                    <td>
                                        <div class="l32x52-qr">
                                            <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('QR', quant.product_id.barcode, 50, 50)" max-height="50" alt="Barcode"/><br/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="l32x52-udi">
                                            <img src="/stock_quant_labels/static/src/img/udi.png" alt="Logo UDI"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="l32x52-barcode">
                                            <img t-att-src="'/report/barcode/Code128/'+quant.product_id.barcode" height="50" width="120" alt="Barcode"/><br/>
                                            <span t-field="quant.product_id.barcode"/><br/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="l32x52-second-logos">
                            <table>
                                <tr>
                                    <td>
                                        <div class="l32x52-ce">
                                            <img src="/stock_quant_labels/static/src/img/ce.png" alt="Logo CE"/>
                                            <span t-field="quant.product_id.on_label"/><br/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="l32x52-degree">
                                            <img src="/stock_quant_labels/static/src/img/degree.png" alt="Logo Degree"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="l32x52-md">
                                            <img src="/stock_quant_labels/static/src/img/md.png" alt="Logo MD"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="l32x52-third-logos">
                            <table>
                                <tr>
                                    <td>
                                        <div class="l32x52-factory">
                                            <img src="/stock_quant_labels/static/src/img/factory.png" alt="Logo Factory"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="l32x52-label_manufacturer">
                                            <span t-field="quant.product_id.label_manufacturer"/><br/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="l32x52-fourth-logos">
                            <table>
                                <tr>
                                    <td>
                                        <div class="l32x52-commercial">
                                            <img src="/stock_quant_labels/static/src/img/commercial.png" alt="Logo Commercial"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="l32x52-made_by">
                                            <span t-field="quant.product_id.label_made_by"/><br/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="page-break-after:always"/>
                    </div>
                </t>
            </div>
        </t>
    </template>
    <template id="label_32x52_report_label">
        <t t-call="web.html_container">
            <t t-set="quants" t-value="docs.env['stock.quant'].browse(quant_ids)"/>
            <t t-call="stock_quant_labels.label_32x52_report_document"/>
        </t>
    </template>
</odoo>
