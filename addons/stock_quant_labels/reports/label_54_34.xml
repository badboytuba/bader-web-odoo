<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="label_54x34_report_document">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-foreach="quants" t-as="quant">
                    <div id="label54x34">
                        <div class="l54x34-logo-bader">
                            <img src="/stock_quant_labels/static/src/img/bader.png" alt="Logo Bader"/>
                        </div>
                        <div class="l54x34-ce">
                            <img src="/stock_quant_labels/static/src/img/ce.png" alt="Logo CE"/>
                        </div>
                        <div class="clearfix"></div>
                        <p> </p>
                        <table class="l54x34-table table table-sm">
                            <tr>
                                <td>
                                    <div class="l54x34-tech_name">
                                        <t t-if="quant.product_id.tech_name_1">
                                            <span class="strong" t-field="quant.product_id.tech_name_1"/>
                                        </t>
                                    </div>
                                </td>
                                <td>
                                    <div class="l54x34-tech_value">
                                        <t t-if="quant.product_id.tech_value_1">
                                            <span class="strong" t-field="quant.product_id.tech_value_1"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="l54x34-tech_name">
                                        <t t-if="quant.product_id.tech_name_2">
                                            <span class="strong" t-field="quant.product_id.tech_name_2"/>
                                        </t>
                                    </div>
                                </td>
                                <td>
                                    <div class="l54x34-tech_value">
                                        <t t-if="quant.product_id.tech_value_2">
                                            <span class="strong" t-field="quant.product_id.tech_value_2"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="l54x34-tech_name">
                                        <t t-if="quant.product_id.tech_name_3">
                                            <span class="strong" t-field="quant.product_id.tech_name_3"/>
                                        </t>
                                    </div>
                                </td>
                                <td>
                                    <div class="l54x34-tech_value">
                                        <t t-if="quant.product_id.tech_value_3">
                                            <span class="strong" t-field="quant.product_id.tech_value_3"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="l54x34-tech_name">
                                        <t t-if="quant.product_id.tech_name_4">
                                            <span class="strong" t-field="quant.product_id.tech_name_4"/>
                                        </t>
                                    </div>
                                </td>
                                <td>
                                    <div class="l54x34-tech_value">
                                        <t t-if="quant.product_id.tech_value_4">
                                            <span class="strong" t-field="quant.product_id.tech_value_4"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="l54x34-tech_name">
                                        <t t-if="quant.product_id.tech_name_5">
                                            <span class="strong" t-field="quant.product_id.tech_name_5"/>
                                        </t>
                                    </div>
                                </td>
                                <td>
                                    <div class="l54x34-tech_value">
                                        <t t-if="quant.product_id.tech_value_5">
                                            <span class="strong" t-field="quant.product_id.tech_value_5"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <div class="l54x34-serial">
                            <t t-if="quant.lot_id.name">
                                <span class="strong">SERIE: </span><span class="strong" t-field="quant.lot_id.name"/>
                            </t>
                        </div>
                        <div style="page-break-after:always"/>
                    </div>
                </t>
            </div>
        </t>
    </template>
    <template id="label_54x34_report_label">
        <t t-call="web.html_container">
            <t t-set="quants" t-value="docs.env['stock.quant'].browse(quant_ids)"/>
            <t t-call="stock_quant_labels.label_54x34_report_document"/>
        </t>
    </template>
</odoo>
