<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================
         Bader Shop - Template Overrides
         Front parity aligned to Bader-AR catalog layout
         ============================================= -->

    <template id="bader_shop_style" inherit_id="website_sale.products"
              name="Bader Shop Styling" priority="20">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="bader-shop-wrap" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('container') and hasclass('oe_website_sale')]" position="attributes">
            <attribute name="class" add="bader-shop-container" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='products_grid']" position="attributes">
            <attribute name="class" add="bader-shop-grid" separator=" "/>
        </xpath>
    </template>

    <template id="bader_shop_title" inherit_id="website_sale.products"
              name="Bader Shop Title" priority="21">
        <xpath expr="//t[@t-set='additional_title']" position="replace">
            <t t-set="additional_title">Catálogo</t>
        </xpath>
    </template>

    <template id="bader_shop_hero" inherit_id="website_sale.products"
              name="Bader Shop Hero" priority="22">
        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
            <section class="bader-hero" id="bader_catalog_hero">
                <div class="bader-hero__container">
                    <nav class="bader-hero__breadcrumb">
                        <a href="/">Home</a>
                        <span class="bader-hero__chevron">&#8250;</span>
                        <t t-if="category">
                            <a href="/productos">Catálogo</a>
                            <span class="bader-hero__chevron">&#8250;</span>
                            <span t-esc="category.name"/>
                        </t>
                        <t t-else="">
                            <span>Catálogo</span>
                        </t>
                    </nav>

                    <h1 class="bader-hero__title">
                        <t t-if="category">
                            <t t-esc="category.name"/>
                        </t>
                        <t t-else="">Nuestro Catalogo</t>
                    </h1>
                    <p class="bader-hero__subtitle">
                        <t t-if="category">
                            Equipamiento odontologico profesional para potenciar tu practica.
                        </t>
                        <t t-else="">
                            Equipamiento odontologico para clinicas, laboratorios y estudiantes.
                        </t>
                    </p>

                    <div t-if="not category" class="bader-hero__quick-nav" role="navigation" aria-label="Segmentos del catalogo">
                        <a href="/productos?search=clinica" class="bader-hero__quick-link">
                            <i class="fa fa-hospital-o"/>
                            Clinica Dental
                        </a>
                        <a href="/productos?search=laboratorio" class="bader-hero__quick-link">
                            <i class="fa fa-flask"/>
                            Laboratorio
                        </a>
                        <a href="/productos?search=estudiantes" class="bader-hero__quick-link">
                            <i class="fa fa-graduation-cap"/>
                            Estudiantes
                        </a>
                        <a href="/productos" class="bader-hero__quick-link bader-hero__quick-link--all">
                            <i class="fa fa-th-large"/>
                            Ver todo
                        </a>
                    </div>
                </div>
            </section>
            <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Catalogo de Productos Bader Argentina",
  "url": "<t t-esc='request.httprequest.url'/>",
  "inLanguage": "es-AR",
  "about": "Catalogo de equipamiento odontologico para clinicas, laboratorios y estudiantes.",
  "publisher": {
    "@type": "Organization",
    "name": "Bader Argentina",
    "url": "<t t-esc="(request.httprequest.url_root or '').rstrip('/')" />"
  }
}
            </script>
        </xpath>
    </template>

    <template id="bader_shop_toolbar_filters" inherit_id="website_sale.products"
              name="Bader Shop Quick Filters" priority="23">
        <xpath expr="//div[hasclass('products_header')]" position="after">
            <div class="bader-filter-chips" data-bader-quick-filters="1">
                <span class="bader-filter-chips__label">Filtros rapidos:</span>
                <a href="/productos?bader_qf=ofertas" class="bader-chip" data-bader-qf="ofertas">
                    <i class="fa fa-tag"/> Ofertas
                </a>
                <a href="/productos?bader_qf=mas-vendidos&amp;order=website_sequence+asc"
                   class="bader-chip"
                   data-bader-qf="mas-vendidos"
                   data-bader-order="website_sequence asc">
                    <i class="fa fa-fire"/> Mas vendidos
                </a>
                <a href="/productos?bader_qf=nuevos&amp;order=create_date+desc"
                   class="bader-chip"
                   data-bader-qf="nuevos"
                   data-bader-order="create_date desc">
                    <i class="fa fa-star"/> Nuevos
                </a>
                <a href="/productos?bader_qf=envio-gratis" class="bader-chip" data-bader-qf="envio-gratis">
                    <i class="fa fa-truck"/> Envio gratis
                </a>
                <a href="/productos?bader_qf=destacados&amp;order=website_sequence+asc"
                   class="bader-chip"
                   data-bader-qf="destacados"
                   data-bader-order="website_sequence asc">
                    <i class="fa fa-certificate"/> Destacados
                </a>
            </div>
            <div class="bader-active-filters" data-bader-active-filters="1"/>
            <div class="bader-shop-toolbar-extras">
                <div class="bader-view-toggle" data-bader-view-toggle="1">
                    <span class="bader-view-toggle__label">Vista:</span>
                    <button type="button"
                            class="bader-view-btn is-active"
                            data-bader-view="grid"
                            aria-pressed="true">
                        <i class="fa fa-th-large"/> Grid
                    </button>
                    <button type="button"
                            class="bader-view-btn"
                            data-bader-view="list"
                            aria-pressed="false">
                        <i class="fa fa-list"/> Lista
                    </button>
                </div>
            </div>
            <div class="bader-search-feedback" data-bader-search-feedback="1" hidden="hidden"/>
        </xpath>
    </template>

    <template id="bader_shop_product_count" inherit_id="website_sale.products"
              name="Bader Shop Product Count" priority="24">
        <xpath expr="//div[hasclass('o_wsale_products_grid_table_wrapper')]" position="before">
            <div class="bader-product-count" t-if="products">
                <span><t t-esc="len(products)"/> productos encontrados</span>
            </div>
        </xpath>
    </template>

    <template id="bader_shop_empty_state" inherit_id="website_sale.products"
              name="Bader Shop Empty State" priority="25">
        <xpath expr="//div[hasclass('text-center') and hasclass('text-muted') and hasclass('mt128') and hasclass('mb256')]" position="replace">
            <div t-nocache="get the actual search" t-else="" class="text-center text-muted mt128 mb256">
                <h3 class="mt8">No se encontraron productos</h3>
                <p t-if="search">
                    No hay resultados para "<strong t-esc="search"/>".
                </p>
                <p t-elif="category">
                    No hay productos publicados en esta categoria.
                </p>
                <p t-else="">
                    Aun no hay productos publicados en el catalogo.
                </p>
                <a href="/productos" class="btn btn-outline-secondary mt-3">Limpiar filtros</a>
            </div>
        </xpath>
    </template>

    <template id="bader_shop_page_js" inherit_id="website_sale.products"
              name="Bader Shop Page JS" priority="90">
        <xpath expr="//div[@id='wrap']" position="inside">
            <script type="text/javascript" src="/bader_website/static/src/js/shop_page.js"/>
        </xpath>
    </template>

</odoo>
