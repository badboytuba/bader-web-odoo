<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==============================================
         Bader Header - Dark theme + Custom Right Side
         ============================================== -->
    <template id="bader_header_class" inherit_id="website.layout"
              name="Bader Header Styling" customize_show="True" priority="50">

        <!-- Add Bader class to header -->
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="class" add="bader-header" separator=" "/>
        </xpath>

        <!-- Inject search pill AFTER the navbar collapse menu (right side) -->
        <xpath expr="//div[@id='top_menu_collapse']" position="after">
            <div class="bader-header-right d-none d-lg-flex align-items-center">
                <a href="#" class="bader-search-pill" id="baderSearchPill">
                    <i class="fa fa-search"/>
                    <span>Buscar con IA</span>
                    <kbd>Q</kbd>
                </a>
            </div>
        </xpath>

        <!-- Mobile drawer: app-style menu blocks -->
        <xpath expr="//div[@id='top_menu_collapse']" position="inside">
            <div class="bader-mobile-drawer d-lg-none">
                <button type="button" class="bader-mobile-search" id="baderSearchPillMobile">
                    <span class="bader-mobile-search__left">
                        <i class="fa fa-magic"/>
                        <span>Buscar con IA</span>
                    </span>
                    <i class="fa fa-search"/>
                </button>

                <section class="bader-mobile-block">
                    <p class="bader-mobile-label">Productos</p>

                    <article class="bader-mobile-niche" data-bader-niche="clinica">
                        <button type="button" class="bader-mobile-niche__toggle" data-bader-niche-toggle="clinica">
                            <span class="bader-mobile-niche__icon bader-mobile-niche__icon--clinica"><i class="fa fa-medkit"/></span>
                            <span class="bader-mobile-niche__title">Clinica Dental</span>
                            <i class="fa fa-chevron-down"/>
                        </button>
                        <div class="bader-mobile-niche__body" data-bader-niche-body="clinica">
                            <a href="/clinica-dental" class="bader-mobile-niche__all">Ver todo Clinica Dental</a>
                            <a href="/productos?niche=clinica-dental&amp;category=sillones">Sillones Dentales</a>
                            <a href="/productos?niche=clinica-dental&amp;category=cbct">CBCT / Radiografia</a>
                            <a href="/productos?niche=clinica-dental&amp;category=autoclaves">Autoclaves</a>
                            <a href="/productos?niche=clinica-dental&amp;category=compresores">Compresores</a>
                            <a href="/productos?niche=clinica-dental&amp;category=rotatorios">Rotatorios</a>
                            <a href="/productos?niche=clinica-dental&amp;category=mobiliario">Mobiliario</a>
                        </div>
                    </article>

                    <article class="bader-mobile-niche" data-bader-niche="laboratorio">
                        <button type="button" class="bader-mobile-niche__toggle" data-bader-niche-toggle="laboratorio">
                            <span class="bader-mobile-niche__icon bader-mobile-niche__icon--lab"><i class="fa fa-flask"/></span>
                            <span class="bader-mobile-niche__title">Laboratorio Dental</span>
                            <i class="fa fa-chevron-down"/>
                        </button>
                        <div class="bader-mobile-niche__body" data-bader-niche-body="laboratorio">
                            <a href="/laboratorio-dental" class="bader-mobile-niche__all">Ver todo Laboratorio Dental</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=mesas">Mesas de Trabajo</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=repasado">Cabinas de Repasado</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=arenadoras">Arenadoras</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=articuladores">Articuladores</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=termoformadoras">Termoformadoras</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=instrumental">Instrumental</a>
                        </div>
                    </article>

                    <article class="bader-mobile-niche" data-bader-niche="estudiantes">
                        <button type="button" class="bader-mobile-niche__toggle" data-bader-niche-toggle="estudiantes">
                            <span class="bader-mobile-niche__icon bader-mobile-niche__icon--student"><i class="fa fa-graduation-cap"/></span>
                            <span class="bader-mobile-niche__title">Estudiantes</span>
                            <i class="fa fa-chevron-down"/>
                        </button>
                        <div class="bader-mobile-niche__body" data-bader-niche-body="estudiantes">
                            <a href="/estudiantes-odontologia" class="bader-mobile-niche__all">Ver todo Estudiantes</a>
                            <a href="/productos?niche=estudiantes&amp;category=kits">Kits de Rotatorios</a>
                            <a href="/productos?niche=estudiantes&amp;category=simuladores">Simuladores</a>
                            <a href="/productos?niche=estudiantes&amp;category=tipodontos">Tipodontos</a>
                            <a href="/productos?niche=estudiantes&amp;category=fantomas">Fantomas</a>
                            <a href="/productos?niche=estudiantes&amp;category=dientes">Dientes de Reposicion</a>
                            <a href="/productos?niche=estudiantes&amp;category=accesorios">Accesorios</a>
                        </div>
                    </article>

                    <a href="/productos" class="bader-mobile-all-products">
                        <i class="fa fa-arrow-right"/> Ver todos los productos
                    </a>
                </section>

                <nav class="bader-mobile-links">
                    <a href="/">Inicio</a>
                    <a href="/sobre-nosotros">Nosotros</a>
                    <a href="/ser-distribuidor">Ser Distribuidor</a>
                    <a href="/descargas">Descargas</a>
                    <a href="/blog">Blog</a>
                    <a href="/servicios">Servicios</a>
                </nav>

                <section class="bader-mobile-account" t-if="request.env.user._is_public()">
                    <a href="/web/login" class="bader-mobile-account__login">Tu Cuenta</a>
                </section>

                <section class="bader-mobile-account" t-else="">
                    <a href="/mi-perfil">Mi Perfil</a>
                    <a href="/mis-pedidos">Mis Pedidos</a>
                    <a href="/mis-facturas">Mis Facturas</a>
                    <a href="/mis-favoritos">Mis Favoritos</a>
                    <a href="/configuracion">Configuracion</a>
                </section>
            </div>
        </xpath>

        <!-- Inject mega menu panel after header (inside wrapwrap) -->
        <xpath expr="//header[@id='top']" position="after">
            <div id="baderMegaMenu" class="bader-mega">
                <div class="container">
                    <div class="bader-mega__header">
                        <h3 class="bader-mega__title">Nuestros Productos</h3>
                        <a href="/productos" class="bader-mega__view-all">
                            Ver todos los productos <i class="fa fa-arrow-right"/>
                        </a>
                    </div>

                    <div class="bader-mega__grid">
                        <!-- Column 1: Clinica Dental -->
                        <div class="bader-mega__col">
                            <div class="bader-mega__col-header">
                                <div class="bader-mega__icon bader-mega__icon--clinica">
                                    <i class="fa fa-medkit"/>
                                </div>
                                <div>
                                    <div class="bader-mega__col-title">Clinica Dental</div>
                                    <div class="bader-mega__col-desc">Equipamiento profesional</div>
                                </div>
                            </div>
                            <ul class="bader-mega__list">
                                <li><a href="/productos?niche=clinica-dental&amp;category=sillones"><i class="fa fa-chevron-right"/> Sillones Dentales</a></li>
                                <li><a href="/productos?niche=clinica-dental&amp;category=cbct"><i class="fa fa-chevron-right"/> CBCT / Radiografia</a></li>
                                <li><a href="/productos?niche=clinica-dental&amp;category=autoclaves"><i class="fa fa-chevron-right"/> Autoclaves</a></li>
                                <li><a href="/productos?niche=clinica-dental&amp;category=compresores"><i class="fa fa-chevron-right"/> Compresores</a></li>
                                <li><a href="/productos?niche=clinica-dental&amp;category=rotatorios"><i class="fa fa-chevron-right"/> Rotatorios</a></li>
                            </ul>
                            <a href="/clinica-dental" class="bader-mega__more">
                                Ver todo <i class="fa fa-plus"/>
                            </a>
                        </div>

                        <!-- Column 2: Laboratorio Dental -->
                        <div class="bader-mega__col">
                            <div class="bader-mega__col-header">
                                <div class="bader-mega__icon bader-mega__icon--lab">
                                    <i class="fa fa-flask"/>
                                </div>
                                <div>
                                    <div class="bader-mega__col-title">Laboratorio Dental</div>
                                    <div class="bader-mega__col-desc">Equipos de precision</div>
                                </div>
                            </div>
                            <ul class="bader-mega__list">
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=mesas"><i class="fa fa-chevron-right"/> Mesas de Trabajo</a></li>
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=repasado"><i class="fa fa-chevron-right"/> Cabinas de Repasado</a></li>
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=arenadoras"><i class="fa fa-chevron-right"/> Arenadoras</a></li>
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=articuladores"><i class="fa fa-chevron-right"/> Articuladores</a></li>
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=termoformadoras"><i class="fa fa-chevron-right"/> Termoformadoras</a></li>
                            </ul>
                            <a href="/laboratorio-dental" class="bader-mega__more">
                                Ver todo <i class="fa fa-plus"/>
                            </a>
                        </div>

                        <!-- Column 3: Estudiantes -->
                        <div class="bader-mega__col">
                            <div class="bader-mega__col-header">
                                <div class="bader-mega__icon bader-mega__icon--student">
                                    <i class="fa fa-graduation-cap"/>
                                </div>
                                <div>
                                    <div class="bader-mega__col-title">Estudiantes</div>
                                    <div class="bader-mega__col-desc">Kits y materiales</div>
                                </div>
                            </div>
                            <ul class="bader-mega__list">
                                <li><a href="/productos?niche=estudiantes&amp;category=kits"><i class="fa fa-chevron-right"/> Kits de Rotatorios</a></li>
                                <li><a href="/productos?niche=estudiantes&amp;category=simuladores"><i class="fa fa-chevron-right"/> Simuladores</a></li>
                                <li><a href="/productos?niche=estudiantes&amp;category=tipodontos"><i class="fa fa-chevron-right"/> Tipodontos</a></li>
                                <li><a href="/productos?niche=estudiantes&amp;category=fantomas"><i class="fa fa-chevron-right"/> Fantomas</a></li>
                                <li><a href="/productos?niche=estudiantes&amp;category=dientes"><i class="fa fa-chevron-right"/> Dientes de Reposicion</a></li>
                            </ul>
                            <a href="/estudiantes-odontologia" class="bader-mega__more">
                                Ver todo <i class="fa fa-plus"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div id="baderCartDrawer" class="bader-cart-drawer" aria-hidden="true">
                <button type="button"
                        class="bader-cart-drawer__backdrop"
                        data-bader-cart-close="1"
                        aria-label="Cerrar carrito"/>

                <aside class="bader-cart-drawer__panel"
                       role="dialog"
                       aria-modal="true"
                       aria-labelledby="baderCartDrawerTitle">
                    <header class="bader-cart-drawer__header">
                        <h3 id="baderCartDrawerTitle">
                            Carrito (<span data-bader-cart-count="1">0</span>)
                        </h3>
                        <button type="button"
                                class="bader-cart-drawer__close"
                                data-bader-cart-close="1"
                                aria-label="Cerrar carrito">
                            <i class="fa fa-times"/>
                        </button>
                    </header>

                    <div class="bader-cart-drawer__body" data-bader-cart-body="1">
                        <div class="bader-cart-drawer__loading">Cargando carrito...</div>
                    </div>

                    <footer class="bader-cart-drawer__footer">
                        <div class="bader-cart-drawer__totals">
                            <div class="bader-cart-drawer__total-row">
                                <span>Subtotal</span>
                                <strong data-bader-cart-subtotal="1">-</strong>
                            </div>
                            <div class="bader-cart-drawer__total-row">
                                <span>Envio</span>
                                <strong class="is-free">Gratis</strong>
                            </div>
                            <div class="bader-cart-drawer__total-row bader-cart-drawer__total-row--final">
                                <span>Total</span>
                                <strong data-bader-cart-total="1">-</strong>
                            </div>
                        </div>

                        <div class="bader-cart-drawer__actions">
                            <a href="/shop/cart" class="btn-bader w-100">Finalizar compra</a>
                            <div class="bader-cart-drawer__secondary">
                                <button type="button"
                                        class="btn-bader-outline w-100"
                                        data-bader-cart-close="1">
                                    Seguir comprando
                                </button>
                                <button type="button"
                                        class="bader-cart-drawer__clear"
                                        data-bader-cart-clear="1"
                                        title="Vaciar carrito"
                                        aria-label="Vaciar carrito">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                        </div>
                    </footer>
                </aside>
            </div>
        </xpath>

    </template>

</odoo>
