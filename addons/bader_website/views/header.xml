<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==============================================
         Bader Header - Dark theme + Custom Right Side
         ============================================== -->
    <template id="bader_header_class" inherit_id="website.layout"
              name="Bader Header Styling" customize_show="True" priority="50">

        <!-- Add Bader class to header -->
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="class" add="bader-header" separator=" "/>
        </xpath>

        <!-- Inject search pill AFTER the navbar collapse menu (right side) -->
        <xpath expr="//div[@id='top_menu_collapse']" position="after">
            <div class="bader-header-right d-none d-lg-flex align-items-center">
                <a href="#" class="bader-search-pill" id="baderSearchPill">
                    <i class="fa fa-magic"/>
                    <span>Buscar con IA</span>
                </a>
            </div>
        </xpath>

        <!-- Mobile drawer: app-style menu blocks -->
        <xpath expr="//div[@id='top_menu_collapse']" position="inside">
            <div class="bader-mobile-drawer d-lg-none">
                <button type="button" class="bader-mobile-search" id="baderSearchPillMobile">
                    <span class="bader-mobile-search__left">
                        <i class="fa fa-magic"/>
                        <span>Buscar con IA</span>
                    </span>
                    <i class="fa fa-search"/>
                </button>

                <section class="bader-mobile-block">
                    <p class="bader-mobile-label">Productos</p>

                    <article class="bader-mobile-niche" data-bader-niche="clinica">
                        <button type="button" class="bader-mobile-niche__toggle" data-bader-niche-toggle="clinica">
                            <span class="bader-mobile-niche__icon bader-mobile-niche__icon--clinica"><i class="fa fa-medkit"/></span>
                            <span class="bader-mobile-niche__title">Clinica Dental</span>
                            <i class="fa fa-chevron-down"/>
                        </button>
                        <div class="bader-mobile-niche__body" data-bader-niche-body="clinica">
                            <a href="/clinica-dental" class="bader-mobile-niche__all">Ver todo Clinica Dental</a>
                            <a href="/productos?niche=clinica-dental&amp;category=sillones">Sillones Dentales</a>
                            <a href="/productos?niche=clinica-dental&amp;category=cbct">CBCT / Radiografia</a>
                            <a href="/productos?niche=clinica-dental&amp;category=autoclaves">Autoclaves</a>
                            <a href="/productos?niche=clinica-dental&amp;category=compresores">Compresores</a>
                            <a href="/productos?niche=clinica-dental&amp;category=rotatorios">Rotatorios</a>
                            <a href="/productos?niche=clinica-dental&amp;category=mobiliario">Mobiliario</a>
                        </div>
                    </article>

                    <article class="bader-mobile-niche" data-bader-niche="laboratorio">
                        <button type="button" class="bader-mobile-niche__toggle" data-bader-niche-toggle="laboratorio">
                            <span class="bader-mobile-niche__icon bader-mobile-niche__icon--lab"><i class="fa fa-flask"/></span>
                            <span class="bader-mobile-niche__title">Laboratorio Dental</span>
                            <i class="fa fa-chevron-down"/>
                        </button>
                        <div class="bader-mobile-niche__body" data-bader-niche-body="laboratorio">
                            <a href="/laboratorio-dental" class="bader-mobile-niche__all">Ver todo Laboratorio Dental</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=mesas">Mesas de Trabajo</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=repasado">Cabinas de Repasado</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=arenadoras">Arenadoras</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=articuladores">Articuladores</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=termoformadoras">Termoformadoras</a>
                            <a href="/productos?niche=laboratorio-dental&amp;category=instrumental">Instrumental</a>
                        </div>
                    </article>

                    <article class="bader-mobile-niche" data-bader-niche="estudiantes">
                        <button type="button" class="bader-mobile-niche__toggle" data-bader-niche-toggle="estudiantes">
                            <span class="bader-mobile-niche__icon bader-mobile-niche__icon--student"><i class="fa fa-graduation-cap"/></span>
                            <span class="bader-mobile-niche__title">Estudiantes</span>
                            <i class="fa fa-chevron-down"/>
                        </button>
                        <div class="bader-mobile-niche__body" data-bader-niche-body="estudiantes">
                            <a href="/estudiantes-odontologia" class="bader-mobile-niche__all">Ver todo Estudiantes</a>
                            <a href="/productos?niche=estudiantes&amp;category=kits">Kits de Rotatorios</a>
                            <a href="/productos?niche=estudiantes&amp;category=simuladores">Simuladores</a>
                            <a href="/productos?niche=estudiantes&amp;category=tipodontos">Tipodontos</a>
                            <a href="/productos?niche=estudiantes&amp;category=fantomas">Fantomas</a>
                            <a href="/productos?niche=estudiantes&amp;category=dientes">Dientes de Reposicion</a>
                            <a href="/productos?niche=estudiantes&amp;category=accesorios">Accesorios</a>
                        </div>
                    </article>

                    <a href="/productos" class="bader-mobile-all-products">
                        <i class="fa fa-arrow-right"/> Ver todos los productos
                    </a>
                </section>

                <nav class="bader-mobile-links">
                    <a href="/">Inicio</a>
                    <a href="/sobre-nosotros">Nosotros</a>
                    <a href="/ser-distribuidor">Ser Distribuidor</a>
                    <a href="/descargas">Descargas</a>
                    <a href="/blog">Blog</a>
                    <a href="/servicios">Servicios</a>
                </nav>

                <section class="bader-mobile-account" t-if="request.env.user._is_public()">
                    <a href="/web/login?redirect=/"
                       class="bader-mobile-account__login bader-auth-trigger"
                       data-bader-auth-open="login"
                       data-bader-auth-redirect="/">Tu Cuenta</a>
                </section>

                <section class="bader-mobile-account" t-else="">
                    <a href="/mi-perfil">Mi Perfil</a>
                    <a href="/mis-pedidos">Mis Pedidos</a>
                    <a href="/mis-facturas">Mis Facturas</a>
                    <a href="/mis-favoritos">Mis Favoritos</a>
                    <a href="/configuracion">Configuracion</a>
                </section>
            </div>
        </xpath>

        <!-- Inject mega menu panel after header (inside wrapwrap) -->
        <xpath expr="//header[@id='top']" position="after">
            <div id="baderMegaMenu" class="bader-mega">
                <div class="container">
                    <div class="bader-mega__header">
                        <h3 class="bader-mega__title">Nuestros Productos</h3>
                        <a href="/productos" class="bader-mega__view-all">
                            Ver todos los productos <i class="fa fa-arrow-right"/>
                        </a>
                    </div>

                    <div class="bader-mega__grid">
                        <!-- Column 1: Clinica Dental -->
                        <div class="bader-mega__col">
                            <div class="bader-mega__col-header">
                                <div class="bader-mega__icon bader-mega__icon--clinica">
                                    <i class="fa fa-medkit"/>
                                </div>
                                <div>
                                    <div class="bader-mega__col-title">Clinica Dental</div>
                                    <div class="bader-mega__col-desc">Equipamiento profesional</div>
                                </div>
                            </div>
                            <ul class="bader-mega__list">
                                <li><a href="/productos?niche=clinica-dental&amp;category=sillones"><i class="fa fa-chevron-right"/> Sillones Dentales</a></li>
                                <li><a href="/productos?niche=clinica-dental&amp;category=cbct"><i class="fa fa-chevron-right"/> CBCT / Radiografia</a></li>
                                <li><a href="/productos?niche=clinica-dental&amp;category=autoclaves"><i class="fa fa-chevron-right"/> Autoclaves</a></li>
                                <li><a href="/productos?niche=clinica-dental&amp;category=compresores"><i class="fa fa-chevron-right"/> Compresores</a></li>
                                <li><a href="/productos?niche=clinica-dental&amp;category=rotatorios"><i class="fa fa-chevron-right"/> Rotatorios</a></li>
                            </ul>
                            <a href="/clinica-dental" class="bader-mega__more">
                                Ver todo <i class="fa fa-plus"/>
                            </a>
                        </div>

                        <!-- Column 2: Laboratorio Dental -->
                        <div class="bader-mega__col">
                            <div class="bader-mega__col-header">
                                <div class="bader-mega__icon bader-mega__icon--lab">
                                    <i class="fa fa-flask"/>
                                </div>
                                <div>
                                    <div class="bader-mega__col-title">Laboratorio Dental</div>
                                    <div class="bader-mega__col-desc">Equipos de precision</div>
                                </div>
                            </div>
                            <ul class="bader-mega__list">
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=mesas"><i class="fa fa-chevron-right"/> Mesas de Trabajo</a></li>
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=repasado"><i class="fa fa-chevron-right"/> Cabinas de Repasado</a></li>
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=arenadoras"><i class="fa fa-chevron-right"/> Arenadoras</a></li>
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=articuladores"><i class="fa fa-chevron-right"/> Articuladores</a></li>
                                <li><a href="/productos?niche=laboratorio-dental&amp;category=termoformadoras"><i class="fa fa-chevron-right"/> Termoformadoras</a></li>
                            </ul>
                            <a href="/laboratorio-dental" class="bader-mega__more">
                                Ver todo <i class="fa fa-plus"/>
                            </a>
                        </div>

                        <!-- Column 3: Estudiantes -->
                        <div class="bader-mega__col">
                            <div class="bader-mega__col-header">
                                <div class="bader-mega__icon bader-mega__icon--student">
                                    <i class="fa fa-graduation-cap"/>
                                </div>
                                <div>
                                    <div class="bader-mega__col-title">Estudiantes</div>
                                    <div class="bader-mega__col-desc">Kits y materiales</div>
                                </div>
                            </div>
                            <ul class="bader-mega__list">
                                <li><a href="/productos?niche=estudiantes&amp;category=kits"><i class="fa fa-chevron-right"/> Kits de Rotatorios</a></li>
                                <li><a href="/productos?niche=estudiantes&amp;category=simuladores"><i class="fa fa-chevron-right"/> Simuladores</a></li>
                                <li><a href="/productos?niche=estudiantes&amp;category=tipodontos"><i class="fa fa-chevron-right"/> Tipodontos</a></li>
                                <li><a href="/productos?niche=estudiantes&amp;category=fantomas"><i class="fa fa-chevron-right"/> Fantomas</a></li>
                                <li><a href="/productos?niche=estudiantes&amp;category=dientes"><i class="fa fa-chevron-right"/> Dientes de Reposicion</a></li>
                            </ul>
                            <a href="/estudiantes-odontologia" class="bader-mega__more">
                                Ver todo <i class="fa fa-plus"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div id="baderCartDrawer" class="bader-cart-drawer" aria-hidden="true">
                <button type="button"
                        class="bader-cart-drawer__backdrop"
                        data-bader-cart-close="1"
                        aria-label="Cerrar carrito"/>

                <aside class="bader-cart-drawer__panel"
                       role="dialog"
                       aria-modal="true"
                       aria-labelledby="baderCartDrawerTitle">
                    <header class="bader-cart-drawer__header">
                        <h3 id="baderCartDrawerTitle">
                            Carrito (<span data-bader-cart-count="1">0</span>)
                        </h3>
                        <button type="button"
                                class="bader-cart-drawer__close"
                                data-bader-cart-close="1"
                                aria-label="Cerrar carrito">
                            <i class="fa fa-times"/>
                        </button>
                    </header>

                    <div class="bader-cart-drawer__body" data-bader-cart-body="1">
                        <div class="bader-cart-drawer__loading">Cargando carrito...</div>
                    </div>

                    <footer class="bader-cart-drawer__footer">
                        <div class="bader-cart-drawer__totals">
                            <div class="bader-cart-drawer__total-row">
                                <span>Subtotal</span>
                                <strong data-bader-cart-subtotal="1">-</strong>
                            </div>
                            <div class="bader-cart-drawer__total-row">
                                <span>Envio</span>
                                <strong class="is-free">Gratis</strong>
                            </div>
                            <div class="bader-cart-drawer__total-row bader-cart-drawer__total-row--final">
                                <span>Total</span>
                                <strong data-bader-cart-total="1">-</strong>
                            </div>
                        </div>

                        <div class="bader-cart-drawer__actions">
                            <a href="/shop/cart" class="btn-bader w-100">Finalizar compra</a>
                            <div class="bader-cart-drawer__secondary">
                                <button type="button"
                                        class="btn-bader-outline w-100"
                                        data-bader-cart-close="1">
                                    Seguir comprando
                                </button>
                                <button type="button"
                                        class="bader-cart-drawer__clear"
                                        data-bader-cart-clear="1"
                                        title="Vaciar carrito"
                                        aria-label="Vaciar carrito">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                        </div>
                    </footer>
                </aside>
            </div>

            <div id="baderAiSearchModal" class="bader-ai-search" aria-hidden="true">
                <button type="button"
                        class="bader-ai-search__backdrop"
                        data-bader-ai-close="1"
                        aria-label="Cerrar búsqueda"/>

                <section class="bader-ai-search__panel"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="baderAiSearchTitle">
                    <header class="bader-ai-search__header">
                        <div class="bader-ai-search__title-wrap">
                            <span class="bader-ai-search__title-icon"><i class="fa fa-magic"/></span>
                            <div>
                                <h3 id="baderAiSearchTitle">BÚSQUEDA INTELIGENTE</h3>
                                <p>Powered by Nancy AI</p>
                            </div>
                        </div>
                        <button type="button"
                                class="bader-ai-search__close"
                                data-bader-ai-close="1"
                                aria-label="Cerrar">
                            <i class="fa fa-times"/>
                        </button>
                    </header>

                    <form class="bader-ai-search__form" data-bader-ai-form="1">
                        <div class="bader-ai-search__input-wrap">
                            <i class="fa fa-magic bader-ai-search__lead-icon"/>
                            <input type="text"
                                   data-bader-ai-input="1"
                                   autocomplete="off"
                                   placeholder="Pregúntame lo que necesitas... Ej: 'Necesito equipar mi primera clínica'"/>
                            <button type="button"
                                    class="bader-ai-search__voice"
                                    data-bader-ai-voice="1"
                                    aria-label="Búsqueda por voz">
                                <i class="fa fa-microphone"/>
                            </button>
                            <button type="submit" class="bader-ai-search__submit">
                                <i class="fa fa-search"/>
                                Buscar
                            </button>
                        </div>
                    </form>

                    <section class="bader-ai-search__section bader-ai-search__section--compact">
                        <div class="bader-ai-search__chips" data-bader-ai-filters="1">
                            <button type="button" class="bader-ai-search__chip" data-bader-ai-filter="clinica">
                                <i class="fa fa-hospital-o"/>
                                Para Clínicas
                            </button>
                            <button type="button" class="bader-ai-search__chip" data-bader-ai-filter="laboratorio">
                                <i class="fa fa-flask"/>
                                Para Labs
                            </button>
                            <button type="button" class="bader-ai-search__chip" data-bader-ai-filter="estudiantes">
                                <i class="fa fa-graduation-cap"/>
                                Estudiantes
                            </button>
                        </div>
                    </section>

                    <section class="bader-ai-search__section">
                        <h4 class="bader-ai-search__label">
                            <i class="fa fa-line-chart"/>
                            Búsquedas populares
                        </h4>
                        <div class="bader-ai-search__chips bader-ai-search__chips--queries">
                            <button type="button" class="bader-ai-search__chip bader-ai-search__chip--query" data-bader-ai-query="Nano Banan Pro 2">
                                <i class="fa fa-search"/>
                                Nano Banan Pro 2
                            </button>
                            <button type="button" class="bader-ai-search__chip bader-ai-search__chip--query" data-bader-ai-query="Autoclave clase B">
                                <i class="fa fa-search"/>
                                Autoclave clase B
                            </button>
                            <button type="button" class="bader-ai-search__chip bader-ai-search__chip--query" data-bader-ai-query="Rayos X digital">
                                <i class="fa fa-search"/>
                                Rayos X digital
                            </button>
                            <button type="button" class="bader-ai-search__chip bader-ai-search__chip--query" data-bader-ai-query="Equipo inicial clínica">
                                <i class="fa fa-search"/>
                                Equipo inicial clínica
                            </button>
                        </div>
                    </section>

                    <section class="bader-ai-search__section">
                        <h4 class="bader-ai-search__label">
                            <i class="fa fa-magic"/>
                            Prueba preguntar...
                        </h4>
                        <div class="bader-ai-search__examples">
                            <button type="button" class="bader-ai-search__example" data-bader-ai-query="Qué necesito para abrir mi clínica">
                                <span>"¿Qué necesito para abrir mi clínica?"</span>
                                <i class="fa fa-arrow-right"/>
                            </button>
                            <button type="button" class="bader-ai-search__example" data-bader-ai-query="Algo económico para empezar">
                                <span>"Algo económico para empezar"</span>
                                <i class="fa fa-arrow-right"/>
                            </button>
                            <button type="button" class="bader-ai-search__example" data-bader-ai-query="El mejor sillón del mercado">
                                <span>"El mejor sillón del mercado"</span>
                                <i class="fa fa-arrow-right"/>
                            </button>
                            <button type="button" class="bader-ai-search__example" data-bader-ai-query="Equipos con financiación">
                                <span>"Equipos con financiación"</span>
                                <i class="fa fa-arrow-right"/>
                            </button>
                        </div>
                    </section>

                    <section class="bader-ai-search__section">
                        <div class="bader-ai-search__capabilities">
                            <h4>¿QUÉ PUEDO HACER POR VOS?</h4>
                            <div class="bader-ai-search__cap-grid">
                                <div class="bader-ai-search__cap-item"><i class="fa fa-search"/> Buscar productos por nombre o descripción</div>
                                <div class="bader-ai-search__cap-item"><i class="fa fa-lightbulb-o"/> Recomendar equipos según tus necesidades</div>
                                <div class="bader-ai-search__cap-item"><i class="fa fa-building-o"/> Armar un presupuesto para tu clínica</div>
                                <div class="bader-ai-search__cap-item"><i class="fa fa-cogs"/> Responder preguntas técnicas</div>
                            </div>
                        </div>
                    </section>
                </section>
            </div>

            <t t-if="request.website.is_public_user()">
                <div id="baderAuthModal" class="bader-auth-modal" aria-hidden="true">
                    <button type="button"
                            class="bader-auth-modal__backdrop"
                            data-bader-auth-close="1"
                            aria-label="Cerrar cuenta"/>

                    <aside class="bader-auth-modal__panel"
                           role="dialog"
                           aria-modal="true"
                           aria-labelledby="baderAuthModalTitle">
                        <header class="bader-auth-modal__header">
                            <h3 id="baderAuthModalTitle">Tu Cuenta</h3>
                            <button type="button"
                                    class="bader-auth-modal__close"
                                    data-bader-auth-close="1"
                                    aria-label="Cerrar">
                                <i class="fa fa-times"/>
                            </button>
                        </header>

                        <div class="bader-auth-modal__tabs" role="tablist" aria-label="Cuenta">
                            <button type="button" class="is-active" data-bader-auth-tab="login">Iniciar sesion</button>
                            <button type="button" data-bader-auth-tab="register">Crear cuenta</button>
                        </div>

                        <p class="bader-auth-modal__hint" data-bader-auth-hint="1">
                            Accede para ver pedidos, facturas y recomendaciones personalizadas.
                        </p>

                        <form class="bader-auth-modal__form"
                              data-bader-auth-form="login"
                              autocomplete="on">
                            <div class="bader-auth-modal__field">
                                <label>Email</label>
                                <input type="email"
                                       name="login"
                                       required="required"
                                       autocomplete="email"
                                       placeholder="tu@email.com"/>
                            </div>
                            <div class="bader-auth-modal__field">
                                <label>Contrasena</label>
                                <input type="password"
                                       name="password"
                                       required="required"
                                       autocomplete="current-password"
                                       placeholder="********"/>
                            </div>
                            <button type="submit" class="btn-bader w-100">Entrar</button>
                            <a class="bader-auth-modal__forgot" href="/web/reset_password">Olvide mi contrasena</a>
                        </form>

                        <form class="bader-auth-modal__form"
                              data-bader-auth-form="register"
                              autocomplete="on"
                              hidden="hidden">
                            <div class="bader-auth-modal__field">
                                <label>Nombre completo *</label>
                                <input type="text"
                                       name="name"
                                       required="required"
                                       autocomplete="name"
                                       placeholder="Nombre y apellido"/>
                            </div>
                            <div class="bader-auth-modal__grid">
                                <div class="bader-auth-modal__field">
                                    <label>Email *</label>
                                    <input type="email"
                                           name="email"
                                           required="required"
                                           autocomplete="email"
                                           placeholder="tu@email.com"/>
                                </div>
                                <div class="bader-auth-modal__field">
                                    <label>Contrasena *</label>
                                    <input type="password"
                                           name="password"
                                           required="required"
                                           autocomplete="new-password"
                                           minlength="8"
                                           placeholder="Minimo 8 caracteres"/>
                                </div>
                            </div>
                            <div class="bader-auth-modal__field">
                                <label>Confirmar contrasena *</label>
                                <input type="password"
                                       name="confirm_password"
                                       required="required"
                                       autocomplete="new-password"
                                       minlength="8"
                                       placeholder="Repite tu contrasena"/>
                            </div>

                            <div class="bader-auth-modal__field">
                                <label>Perfil profesional *</label>
                                <select name="persona" required="required" data-bader-signup-persona-select="1">
                                    <option value="">Selecciona tu perfil</option>
                                    <option value="clinica">Clinica Dental</option>
                                    <option value="laboratorio">Laboratorio Dental</option>
                                    <option value="estudiantes">Estudiantes</option>
                                </select>
                            </div>

                            <div class="bader-auth-modal__persona-group"
                                 data-bader-signup-persona="clinica"
                                 hidden="hidden">
                                <div class="bader-auth-modal__field">
                                    <label>Cargo *</label>
                                    <select name="clinic_role">
                                        <option value="">Selecciona tu cargo</option>
                                        <option value="dueno">Dueno/a</option>
                                        <option value="gerente">Gerente</option>
                                        <option value="dentista">Dentista</option>
                                        <option value="asistente">Asistente Dental</option>
                                        <option value="recepcionista">Recepcionista</option>
                                    </select>
                                </div>
                                <div class="bader-auth-modal__field">
                                    <label>Especialidades * (elige al menos una)</label>
                                    <div class="bader-auth-modal__checks">
                                        <label><input type="checkbox" name="clinic_specialties" value="general"/> Odontologia General</label>
                                        <label><input type="checkbox" name="clinic_specialties" value="ortodoncia"/> Ortodoncia</label>
                                        <label><input type="checkbox" name="clinic_specialties" value="endodoncia"/> Endodoncia</label>
                                        <label><input type="checkbox" name="clinic_specialties" value="periodoncia"/> Periodoncia</label>
                                        <label><input type="checkbox" name="clinic_specialties" value="implantologia"/> Implantologia</label>
                                        <label><input type="checkbox" name="clinic_specialties" value="cirugia"/> Cirugia</label>
                                        <label><input type="checkbox" name="clinic_specialties" value="odontopediatria"/> Odontopediatria</label>
                                        <label><input type="checkbox" name="clinic_specialties" value="estetica"/> Estetica Dental</label>
                                    </div>
                                </div>
                                <div class="bader-auth-modal__grid">
                                    <div class="bader-auth-modal__field">
                                        <label>Tamano de la clinica</label>
                                        <select name="clinic_size">
                                            <option value="">Selecciona tamano</option>
                                            <option value="pequena">Pequena (1-2 sillones)</option>
                                            <option value="mediana">Mediana (3-5 sillones)</option>
                                            <option value="grande">Grande (6+ sillones)</option>
                                        </select>
                                    </div>
                                    <div class="bader-auth-modal__field">
                                        <label>Anos de experiencia</label>
                                        <input type="number" name="years_experience" min="0" max="80" placeholder="Ej: 5"/>
                                    </div>
                                </div>
                                <div class="bader-auth-modal__field">
                                    <label>Nombre de la clinica</label>
                                    <input type="text" name="clinic_name" placeholder="Ej: Clinica Dental Sonrisa"/>
                                </div>
                            </div>

                            <div class="bader-auth-modal__persona-group"
                                 data-bader-signup-persona="laboratorio"
                                 hidden="hidden">
                                <div class="bader-auth-modal__field">
                                    <label>Tipo de laboratorio *</label>
                                    <select name="lab_type">
                                        <option value="">Selecciona el tipo</option>
                                        <option value="protesico">Protesico</option>
                                        <option value="ortodontico">Ortodontico</option>
                                        <option value="cadcam">CAD/CAM Digital</option>
                                        <option value="general">General</option>
                                    </select>
                                </div>
                                <div class="bader-auth-modal__field">
                                    <label>Especializacion principal *</label>
                                    <select name="lab_specialization">
                                        <option value="">Selecciona especializacion</option>
                                        <option value="zirconio">Zirconio</option>
                                        <option value="metal-ceramica">Metal-Ceramica</option>
                                        <option value="acrilico">Acrilico</option>
                                        <option value="alineadores">Alineadores</option>
                                        <option value="implantes">Implantes</option>
                                        <option value="protesis-removible">Protesis Removible</option>
                                    </select>
                                </div>
                                <div class="bader-auth-modal__grid">
                                    <div class="bader-auth-modal__field">
                                        <label>Tamano del equipo</label>
                                        <select name="lab_team_size">
                                            <option value="">Selecciona tamano</option>
                                            <option value="solo">Solo (1 persona)</option>
                                            <option value="pequeno">Pequeno (2-5 personas)</option>
                                            <option value="mediano">Mediano (6-15 personas)</option>
                                            <option value="grande">Grande (16+ personas)</option>
                                        </select>
                                    </div>
                                    <div class="bader-auth-modal__field">
                                        <label>Nombre del laboratorio</label>
                                        <input type="text" name="lab_name" placeholder="Ej: Laboratorio Dental Elite"/>
                                    </div>
                                </div>
                            </div>

                            <div class="bader-auth-modal__persona-group"
                                 data-bader-signup-persona="estudiantes"
                                 hidden="hidden">
                                <div class="bader-auth-modal__field">
                                    <label>Que estudias? *</label>
                                    <select name="career">
                                        <option value="">Selecciona tu carrera</option>
                                        <option value="odontologia">Odontologia</option>
                                        <option value="protesis">Tecnico en Protesis Dental</option>
                                        <option value="higienista">Higienista Dental</option>
                                        <option value="asistente">Asistente Dental</option>
                                    </select>
                                </div>
                                <div class="bader-auth-modal__field">
                                    <label>Ano de cursado *</label>
                                    <select name="study_year">
                                        <option value="">Selecciona tu ano</option>
                                        <option value="1">1 Ano</option>
                                        <option value="2">2 Ano</option>
                                        <option value="3">3 Ano</option>
                                        <option value="4">4 Ano</option>
                                        <option value="5">5 Ano</option>
                                        <option value="graduado">Graduado Reciente</option>
                                    </select>
                                </div>
                                <div class="bader-auth-modal__grid">
                                    <div class="bader-auth-modal__field">
                                        <label>Universidad</label>
                                        <input type="text" name="university" placeholder="Ej: Universidad de Buenos Aires"/>
                                    </div>
                                    <div class="bader-auth-modal__field">
                                        <label>Ciudad</label>
                                        <input type="text" name="student_city" placeholder="Ej: Buenos Aires"/>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn-bader w-100">Crear cuenta y continuar</button>
                        </form>

                        <p class="bader-auth-modal__message" data-bader-auth-message="1"></p>
                    </aside>
                </div>
            </t>

            <t t-if="not request.website.is_public_user()">
                <div id="baderOnboardingBootstrap" aria-hidden="true"/>
            </t>
        </xpath>

    </template>

</odoo>
