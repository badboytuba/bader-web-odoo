<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bader_product_detail_page"
              inherit_id="website_sale.product"
              name="Bader Product Detail Page"
              priority="40">
        <xpath expr="//t[@t-cache='pricelist,product']" position="attributes">
            <attribute name="t-cache" add="pdp_persona" separator=","/>
        </xpath>
        <xpath expr="//t[@t-set='additional_title']" position="replace">
            <t t-set="additional_title" t-value="pdp_product_name_clean or (product.with_context(lang='es_ES', display_default_code=False).name or product.name)"/>
        </xpath>
        <xpath expr="//*[@id='product_detail']" position="attributes">
            <attribute name="t-attf-class">container py-4 oe_website_sale bader-product-detail #{'discount' if combination_info['has_discounted_price'] else ''}</attribute>
            <attribute name="t-att-data-bader-product-id">product.id</attribute>
            <attribute name="t-att-data-bader-product-url">request.httprequest.path</attribute>
        </xpath>

        <xpath expr="//div[@id='product_detail_main']" position="attributes">
            <attribute name="class" add="bader-app-hero-grid" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='product_detail_main']" position="before">
            <section class="bader-app-pdp-topbar" aria-label="Encabezado del producto">
                <div class="bader-app-pdp-topbar__body">
                    <a class="bader-app-pdp-topbar__back" href="/productos">
                        <i class="fa fa-arrow-left"/>
                        Volver al catálogo
                    </a>
                    <div class="bader-app-pdp-topbar__copy">
                        <span class="bader-app-pdp-topbar__eyebrow">Ficha del producto</span>
                        <nav class="bader-app-pdp-topbar__trail" aria-label="Ruta del producto">
                            <a href="/">Home</a>
                            <i class="fa fa-angle-right"/>
                            <a href="/productos">Catálogo</a>
                            <t t-if="product.public_categ_ids">
                                <i class="fa fa-angle-right"/>
                                <span t-esc="product.public_categ_ids[0].name"/>
                            </t>
                            <i class="fa fa-angle-right"/>
                            <span class="is-current" t-esc="pdp_product_name_clean or product.name"/>
                        </nav>
                        <div class="bader-app-pdp-topbar__chips" aria-label="Datos rapidos del producto">
                            <div class="bader-app-rating-pill bader-app-rating-pill--topbar" aria-label="Valoracion del producto">
                                <span class="bader-app-rating-stars">
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                </span>
                                <span>(4.9)</span>
                            </div>
                            <span class="bader-app-pdp-topbar__chip bader-app-pdp-topbar__chip--sku"
                                  t-if="product_variant and product_variant.default_code">
                                SKU <t t-esc="product_variant.default_code"/>
                            </span>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <xpath expr="//div[@id='product_detail_main']/div[t[@t-call='website_sale.shop_product_images']]" position="attributes">
            <attribute name="class" add="bader-app-gallery-column" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='product_details']" position="attributes">
            <attribute name="class" add="bader-app-info-column" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='product_detail_main']//t[@t-call='website_sale.shop_product_images']" position="replace">
            <t t-set="gallery_images" t-value="product_variant._get_images() if product_variant else product._get_images()"/>
            <section t-attf-class="bader-app-gallery-shell #{'is-single-shot' if len(gallery_images) &lt;= 1 else 'is-multi-shot'}"
                     t-att-data-gallery-count="len(gallery_images)"
                     aria-label="Galeria del producto">
                <div class="bader-app-gallery-shell__stage">
                    <t t-call="website_sale.shop_product_images"/>
                </div>
            </section>
        </xpath>

        <xpath expr="//div[@id='product_details']/h1[@itemprop='name']" position="before">
            <h1 itemprop="name" class="bader-pdp-title" t-esc="pdp_product_name_clean or product.name">Product Name</h1>
        </xpath>

        <xpath expr="//div[@id='product_details']/h1[@itemprop='name'][last()]" position="replace"/>

        <xpath expr="//div[@id='product_details']/h1[@itemprop='name'][last()]" position="after">
            <p class="bader-app-summary">
                <t t-if="pdp_summary_text">
                    <t t-esc="pdp_summary_text"/>
                </t>
                <t t-else="">Equipo odontologico profesional con respaldo Bader, garantia oficial y soporte tecnico especializado.</t>
            </p>
        </xpath>

        <xpath expr="//div[@id='product_details']/p[hasclass('text-muted') and hasclass('my-2')]" position="replace"/>

        <xpath expr="//div[@id='product_details']//t[@t-call='website_sale.product_price']" position="after">
            <div class="bader-app-price-meta">
                <t t-if="'compare_list_price' in product._fields and product.compare_list_price and product.compare_list_price > product.list_price">
                    <span class="bader-app-discount-pill">
                        <i class="fa fa-bolt"/>
                        <t t-esc="int(round(((product.compare_list_price - product.list_price) / product.compare_list_price) * 100))"/>% OFF
                    </span>
                </t>
                <span class="bader-price-note">IVA incluido</span>
                <span class="bader-price-installment-note" data-bader-installment-note="1">12x sin interes</span>
            </div>
            <t t-set="bader_in_stock" t-value="True"/>
            <div t-attf-class="bader-app-stock-pill #{'is-in' if bader_in_stock else 'is-out'}">
                <span class="bader-app-stock-dot"/>
                <span t-if="bader_in_stock">En stock - Envio inmediato</span>
                <span t-else="">Consulta disponibilidad</span>
            </div>
            <div class="bader-app-highlight-grid" role="list" aria-label="Beneficios del producto">
                <span class="bader-app-highlight-pill" role="listitem">
                    <i class="fa fa-truck"/>
                    Envio rapido
                </span>
                <span class="bader-app-highlight-pill" role="listitem">
                    <i class="fa fa-credit-card"/>
                    12 cuotas
                </span>
                <span class="bader-app-highlight-pill" role="listitem">
                    <i class="fa fa-headphones"/>
                    Soporte experto
                </span>
            </div>
        </xpath>

        <xpath expr="//a[@id='add_to_cart']/span" position="replace">
            <span>Agregar al carrito</span>
        </xpath>

        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <div class="bader-app-secondary-actions">
                <button type="button" class="bader-app-buy-now" data-bader-buy-now="1">
                    <i class="fa fa-bolt"/>
                    Comprar ahora
                </button>
                <button type="button"
                        class="bader-app-icon-button"
                        data-bader-wishlist="1"
                        aria-label="Agregar a favoritos"
                        title="Agregar a favoritos">
                    <i class="fa fa-heart-o"/>
                </button>
                <button type="button"
                        class="bader-app-icon-button"
                        data-bader-share="1"
                        aria-label="Compartir producto"
                        title="Compartir producto">
                    <i class="fa fa-share-alt"/>
                </button>
            </div>
            <section class="bader-app-purchase-support" aria-label="Condiciones comerciales y soporte">
                <div class="bader-app-trust-grid bader-app-trust-grid--compact" aria-label="Pruebas de confianza">
                    <article class="bader-app-trust-card">
                        <span class="bader-app-trust-card__icon">
                            <i class="fa fa-truck"/>
                        </span>
                        <div>
                            <strong>Envio y coordinacion</strong>
                            <p>Entrega segun zona y necesidad de instalacion.</p>
                        </div>
                    </article>
                    <article class="bader-app-trust-card">
                        <span class="bader-app-trust-card__icon">
                            <i class="fa fa-shield"/>
                        </span>
                        <div>
                            <strong>Garantia oficial</strong>
                            <p>Respaldo Bader y postventa oficial.</p>
                        </div>
                    </article>
                    <article class="bader-app-trust-card">
                        <span class="bader-app-trust-card__icon">
                            <i class="fa fa-credit-card"/>
                        </span>
                        <div>
                            <strong>Financiacion</strong>
                            <p>Cuotas y medios de pago disponibles.</p>
                        </div>
                    </article>
                    <article class="bader-app-trust-card">
                        <span class="bader-app-trust-card__icon">
                            <i class="fa fa-headphones"/>
                        </span>
                        <div>
                            <strong>Soporte Bader</strong>
                            <p>Asistencia comercial y tecnica directa.</p>
                        </div>
                    </article>
                </div>
                <div class="bader-app-terms-inline" aria-label="Condiciones comerciales">
                    <a href="/terms">Terminos</a>
                    <span>30 dias devolucion</span>
                    <span>Envio 2-3 dias</span>
                </div>
            </section>
        </xpath>

        <xpath expr="//div[@id='o_product_terms_and_share']" position="attributes">
            <attribute name="class" add="bader-app-terms-native" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='o_product_terms_and_share']" position="after">
            <section class="bader-app-mobile-dock" data-bader-mobile-dock="1" aria-label="Acciones rapidas de compra">
                <div class="bader-app-mobile-dock__price-block">
                    <span class="bader-app-mobile-dock__eyebrow">Compra rapida</span>
                    <span class="bader-app-mobile-dock__price" data-bader-mobile-dock-price="1">
                        <t t-esc="combination_info['price']"
                           t-options='{"widget": "monetary", "display_currency": pricelist.currency_id}'/>
                    </span>
                </div>
                <div class="bader-app-mobile-dock__actions">
                    <a class="bader-app-mobile-dock__assist"
                       t-att-href="pdp_whatsapp_url"
                       target="_blank"
                       rel="noopener">
                        Asesoria
                    </a>
                    <button type="button" class="bader-app-mobile-dock__cta" data-bader-mobile-add="1">
                        Agregar
                    </button>
                </div>
            </section>
        </xpath>

        <xpath expr="//div[@id='product_full_description']" position="replace">
            <section id="product_full_description" class="bader-app-detail-section">
                <div class="bader-app-detail-shell">
                    <div class="bader-app-tab-shell">
                        <ul class="nav nav-tabs bader-app-tablist" role="tablist">
                            <li class="nav-item" role="presentation">
                                <a class="nav-link active" id="bader_app_tab_desc_btn" data-bs-toggle="tab" href="#bader_app_tab_desc" role="tab">Descripcion</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link" id="bader_app_tab_specs_btn" data-bs-toggle="tab" href="#bader_app_tab_specs" role="tab">Especificaciones</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link" id="bader_app_tab_shipping_btn" data-bs-toggle="tab" href="#bader_app_tab_shipping" role="tab">Envio</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link" id="bader_app_tab_warranty_btn" data-bs-toggle="tab" href="#bader_app_tab_warranty" role="tab">Garantia</a>
                            </li>
                        </ul>
                    </div>

                    <div class="tab-content bader-app-tab-content">
                        <div class="tab-pane fade show active" id="bader_app_tab_desc" role="tabpanel" aria-labelledby="bader_app_tab_desc_btn">
                            <div class="bader-app-detail-panel-grid">
                                <article class="bader-app-detail-card bader-app-detail-card--main">
                                    <div class="bader-app-detail-card__header">
                                        <h3>Descripcion del producto</h3>
                                        <p>Informacion comercial y compatibilidades disponibles para este articulo.</p>
                                    </div>
                                    <div class="bader-app-description-wrap" data-bader-description-wrap="1">
                                        <div class="bader-app-description-body" t-if="pdp_description_paragraphs or pdp_feature_points">
                                            <t t-foreach="pdp_description_paragraphs" t-as="paragraph">
                                                <p t-esc="paragraph"/>
                                            </t>
                                            <div class="bader-app-description-specs" t-if="pdp_feature_points">
                                                <h4>Caracteristicas destacadas</h4>
                                                <ul>
                                                    <t t-foreach="pdp_feature_points" t-as="point">
                                                        <li t-esc="point"/>
                                                    </t>
                                                </ul>
                                            </div>
                                        </div>
                                        <p class="bader-app-description-body__fallback" t-else="">Producto profesional Bader con calidad europea y soporte tecnico especializado.</p>
                                    </div>
                                    <button type="button"
                                            class="bader-app-description-toggle"
                                            data-bader-description-toggle="1"
                                            aria-expanded="false">
                                        Ver descripcion completa
                                    </button>
                                </article>

                                <aside class="bader-app-detail-rail">
                                    <article class="bader-app-detail-rail-card">
                                        <span class="bader-app-detail-rail-card__eyebrow">Resumen comercial</span>
                                        <h4>Lo esencial del producto</h4>
                                        <p t-esc="pdp_summary_text or 'Informacion comercial y tecnica disponible para este producto.'"/>
                                    </article>
                                    <article class="bader-app-detail-rail-card" t-if="pdp_highlight_points">
                                        <span class="bader-app-detail-rail-card__eyebrow">Puntos clave</span>
                                        <h4>Aspectos a revisar antes de comprar</h4>
                                        <ul class="bader-app-detail-rail-list">
                                            <t t-foreach="pdp_highlight_points" t-as="point">
                                                <li t-if="point_index &lt; 4">
                                                    <span t-esc="point"/>
                                                </li>
                                            </t>
                                        </ul>
                                    </article>
                                    <a t-if="pdp_whatsapp_url"
                                       class="bader-app-detail-rail-cta"
                                       t-att-href="pdp_whatsapp_url"
                                       rel="noopener"
                                       target="_blank">
                                        Consultar este producto
                                    </a>
                                </aside>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="bader_app_tab_specs" role="tabpanel" aria-labelledby="bader_app_tab_specs_btn">
                            <div class="bader-app-detail-panel-grid">
                                <article class="bader-app-detail-card bader-app-detail-card--main">
                                    <div class="bader-app-detail-card__header">
                                        <h3>Especificaciones tecnicas</h3>
                                        <p>Datos base para identificar el producto y compararlo con rapidez.</p>
                                    </div>
                                    <div class="bader-app-spec-grid" role="list" aria-label="Especificaciones tecnicas">
                                        <div class="bader-app-spec-item" role="listitem">
                                            <span>Categoria</span>
                                            <strong>
                                                <span t-if="product.public_categ_ids" t-esc="product.public_categ_ids[0].name"/>
                                                <span t-else="">General</span>
                                            </strong>
                                        </div>
                                        <div class="bader-app-spec-item" role="listitem">
                                            <span>Codigo</span>
                                            <strong>
                                                <span t-if="product_variant and product_variant.default_code" t-esc="product_variant.default_code"/>
                                                <span t-else="">BAD-<t t-esc="product.id"/></span>
                                            </strong>
                                        </div>
                                        <div class="bader-app-spec-item" role="listitem">
                                            <span>Marca</span>
                                            <strong>BADER</strong>
                                        </div>
                                        <div class="bader-app-spec-item" role="listitem">
                                            <span>Origen</span>
                                            <strong>Europa</strong>
                                        </div>
                                        <div class="bader-app-spec-item" role="listitem">
                                            <span>Garantia</span>
                                            <strong>12 meses</strong>
                                        </div>
                                        <div class="bader-app-spec-item" role="listitem">
                                            <span>Soporte</span>
                                            <strong>Comercial + tecnico</strong>
                                        </div>
                                    </div>
                                </article>

                                <aside class="bader-app-detail-rail">
                                    <article class="bader-app-detail-rail-card">
                                        <span class="bader-app-detail-rail-card__eyebrow">Ficha rapida</span>
                                        <h4>Datos destacados</h4>
                                        <ul class="bader-app-detail-rail-list" t-if="pdp_feature_points">
                                            <t t-foreach="pdp_feature_points" t-as="point">
                                                <li t-if="point_index &lt; 6">
                                                    <span t-esc="point"/>
                                                </li>
                                            </t>
                                        </ul>
                                        <p t-else="">Consulta esta ficha para revisar las referencias tecnicas principales del producto.</p>
                                    </article>
                                    <article class="bader-app-detail-rail-card">
                                        <span class="bader-app-detail-rail-card__eyebrow">Respaldo</span>
                                        <h4>Compra con soporte de marca</h4>
                                        <ul class="bader-app-detail-rail-list">
                                            <li>Marca Bader con respaldo comercial y tecnico.</li>
                                            <li>Garantia oficial para defectos de fabricacion.</li>
                                            <li>Atencion para consulta antes y despues de la compra.</li>
                                        </ul>
                                    </article>
                                </aside>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="bader_app_tab_shipping" role="tabpanel" aria-labelledby="bader_app_tab_shipping_btn">
                            <div class="bader-app-detail-panel-grid">
                                <article class="bader-app-detail-card bader-app-detail-card--main">
                                    <div class="bader-app-detail-card__header">
                                        <h3>Informacion de envio</h3>
                                        <p>Condiciones generales de entrega y coordinacion comercial.</p>
                                    </div>
                                    <div class="bader-app-info-panels">
                                        <article class="bader-app-info-panel bader-app-info-panel--emerald">
                                            <span class="bader-app-info-panel__icon">
                                                <i class="fa fa-truck"/>
                                            </span>
                                            <div>
                                                <strong>Envio gratis a todo el pais</strong>
                                                <p>Entrega estimada de 3 a 10 dias habiles segun zona y tipo de producto.</p>
                                            </div>
                                        </article>
                                        <article class="bader-app-info-panel bader-app-info-panel--blue">
                                            <span class="bader-app-info-panel__icon">
                                                <i class="fa fa-map-marker"/>
                                            </span>
                                            <div>
                                                <strong>Coordinacion comercial</strong>
                                                <p>Seguimiento personalizado para retiro, entrega y puesta en marcha cuando aplica.</p>
                                            </div>
                                        </article>
                                    </div>
                                </article>

                                <aside class="bader-app-detail-rail">
                                    <article class="bader-app-detail-rail-card">
                                        <span class="bader-app-detail-rail-card__eyebrow">Proceso de entrega</span>
                                        <h4>Como coordinamos el envio</h4>
                                        <ul class="bader-app-detail-rail-list">
                                            <li>Confirmamos stock, direccion y condiciones de despacho.</li>
                                            <li>Coordinamos salida y seguimiento segun la zona de entrega.</li>
                                            <li>El equipo comercial acompana los casos que requieren gestion especial.</li>
                                        </ul>
                                    </article>
                                    <a t-if="pdp_whatsapp_url"
                                       class="bader-app-detail-rail-cta"
                                       t-att-href="pdp_whatsapp_url"
                                       rel="noopener"
                                       target="_blank">
                                        Consultar tiempos de entrega
                                    </a>
                                </aside>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="bader_app_tab_warranty" role="tabpanel" aria-labelledby="bader_app_tab_warranty_btn">
                            <div class="bader-app-detail-panel-grid">
                                <article class="bader-app-detail-card bader-app-detail-card--main">
                                    <div class="bader-app-detail-card__header">
                                        <h3>Garantia y soporte</h3>
                                        <p>Cobertura, postventa y asistencia disponible para la compra profesional.</p>
                                    </div>
                                    <div class="bader-app-info-panels">
                                        <article class="bader-app-info-panel bader-app-info-panel--purple">
                                            <span class="bader-app-info-panel__icon">
                                                <i class="fa fa-shield"/>
                                            </span>
                                            <div>
                                                <strong>Garantia europea oficial</strong>
                                                <p>Cobertura de 12 meses por defectos de fabricacion y respaldo directo de marca.</p>
                                            </div>
                                        </article>
                                        <article class="bader-app-info-panel bader-app-info-panel--orange">
                                            <span class="bader-app-info-panel__icon">
                                                <i class="fa fa-headphones"/>
                                            </span>
                                            <div>
                                                <strong>Soporte tecnico especializado</strong>
                                                <p>Acompanamiento para instalacion, uso, mantenimiento y continuidad operativa.</p>
                                            </div>
                                        </article>
                                    </div>
                                </article>

                                <aside class="bader-app-detail-rail">
                                    <article class="bader-app-detail-rail-card">
                                        <span class="bader-app-detail-rail-card__eyebrow">Cobertura general</span>
                                        <h4>Postventa con respaldo</h4>
                                        <ul class="bader-app-detail-rail-list">
                                            <li>Garantia oficial sobre defectos de fabricacion.</li>
                                            <li>Orientacion sobre uso, mantenimiento y continuidad operativa.</li>
                                            <li>Atencion comercial y tecnica para consultas de postventa.</li>
                                        </ul>
                                    </article>
                                    <a t-if="pdp_whatsapp_url"
                                       class="bader-app-detail-rail-cta"
                                       t-att-href="pdp_whatsapp_url"
                                       rel="noopener"
                                       target="_blank">
                                        Hablar con postventa
                                    </a>
                                </aside>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <xpath expr="//section[@id='product_full_description']" position="after">
            <section class="bader-app-faq-section" id="bader_pdp_faq">
                <article class="bader-app-faq-shell">
                    <div class="bader-app-studio-head bader-app-studio-head--faq">
                        <div class="bader-app-studio-head__copy">
                            <span class="bader-app-section-heading__eyebrow">Preguntas frecuentes</span>
                            <h2>Respuestas para comprar con mas claridad</h2>
                            <p t-esc="(pdp_persona_copy or {}).get('faq_intro') or 'Respuestas rapidas sobre compra, envio, garantia y soporte.'"/>
                        </div>
                        <aside class="bader-app-studio-summary">
                            <span class="bader-app-studio-summary__eyebrow">Guia rapida</span>
                            <strong>Objeciones resueltas antes de cerrar la compra</strong>
                            <p>Garantia, envio, cuotas y asesoria reunidos en una sola lectura para reducir friccion comercial.</p>
                        </aside>
                    </div>

                    <div class="bader-app-faq-list">
                        <article class="bader-app-faq-item">
                            <span class="bader-app-faq-item__index">1</span>
                            <div class="bader-app-faq-item__body">
                                <h3>Este producto tiene garantia oficial?</h3>
                                <p>Si. Todos los equipos Bader cuentan con garantia oficial y soporte tecnico especializado.</p>
                            </div>
                        </article>
                        <article class="bader-app-faq-item">
                            <span class="bader-app-faq-item__index">2</span>
                            <div class="bader-app-faq-item__body">
                                <h3>El envio esta incluido?</h3>
                                <p>Si. Ofrecemos envio sin cargo y coordinacion comercial para que la entrega no genere friccion.</p>
                            </div>
                        </article>
                        <article class="bader-app-faq-item">
                            <span class="bader-app-faq-item__index">3</span>
                            <div class="bader-app-faq-item__body">
                                <h3>Se puede financiar en cuotas?</h3>
                                <p>Si. Puedes acceder a financiacion de hasta 12 cuotas segun el medio de pago habilitado.</p>
                            </div>
                        </article>
                        <article class="bader-app-faq-item">
                            <span class="bader-app-faq-item__index">4</span>
                            <div class="bader-app-faq-item__body">
                                <h3>Puedo recibir asesoria antes de comprar?</h3>
                                <p>Si. Nuestro equipo comercial y tecnico te ayuda a validar si este producto encaja con tu caso.</p>
                            </div>
                        </article>
                    </div>

                    <div class="bader-app-faq-cta">
                        <div class="bader-app-faq-cta__copy">
                            <span class="bader-app-studio-summary__eyebrow">Asesoria directa</span>
                            <strong t-esc="(pdp_persona_copy or {}).get('faq_cta_title') or 'Necesitas ayuda con este producto?'"/>
                            <p t-esc="(pdp_persona_copy or {}).get('faq_cta_body') or 'Escribenos y te ayudamos con stock, compatibilidad y condiciones comerciales.'"/>
                        </div>
                        <a class="bader-app-faq-cta__button"
                           t-att-href="pdp_whatsapp_url"
                           target="_blank"
                           rel="noopener">
                            <t t-esc="(pdp_persona_copy or {}).get('faq_cta_button') or 'Contactar'"/>
                        </a>
                    </div>
                </article>
            </section>

            <section class="bader-app-related-section" id="bader_pdp_related" t-if="pdp_related_products">
                <div class="bader-app-related-shell">
                    <div class="bader-app-studio-head bader-app-studio-head--related">
                        <div class="bader-app-studio-head__copy">
                            <span class="bader-app-section-heading__eyebrow">Productos relacionados</span>
                            <h2>Complementa tu compra</h2>
                            <p>Accesorios, repuestos y equipos vinculados a este producto.</p>
                        </div>
                        <aside class="bader-app-studio-summary">
                            <span class="bader-app-studio-summary__eyebrow">Seleccion vinculada</span>
                            <strong>Referencias utiles para ampliar la compra</strong>
                            <p>Accesorios, repuestos y equipos relacionados para completar instalacion, reposicion o venta cruzada.</p>
                        </aside>
                    </div>

                    <div class="row g-4 bader-app-related-grid">
                        <t t-foreach="pdp_related_products" t-as="rel">
                            <div class="col-12 col-sm-6 col-xl-4">
                                <t t-set="rel_name_source"
                                   t-value="(rel.with_context(lang='es_ES', display_default_code=False).name or rel.name or '').strip()"/>
                                <t t-set="rel_name_clean"
                                   t-value="rel_name_source.split('] ', 1)[1].strip() if rel_name_source.startswith('[') and '] ' in rel_name_source else rel_name_source"/>
                                <a t-att-href="rel.website_url" class="bader-app-related-card">
                                    <span class="bader-app-related-card__tag">
                                        <span t-if="rel.public_categ_ids" t-esc="rel.public_categ_ids[0].name"/>
                                        <span t-else="">Producto</span>
                                    </span>
                                    <span class="bader-app-related-card__media">
                                        <span class="bader-app-related-card__image">
                                            <img t-att-src="website.image_url(rel, 'image_256')"
                                                 t-att-srcset="'%s 256w, %s 512w' % (website.image_url(rel, 'image_256'), website.image_url(rel, 'image_512'))"
                                                 sizes="(max-width: 575px) 78vw, (max-width: 1199px) 44vw, 24vw"
                                                 t-att-alt="rel_name_clean or rel_name_source"
                                                 loading="lazy"
                                                 decoding="async"
                                                 width="256"
                                                 height="256"/>
                                        </span>
                                    </span>
                                    <span class="bader-app-related-card__body">
                                        <span class="bader-app-related-card__name" t-esc="rel_name_clean or rel_name_source"/>
                                        <span class="bader-app-related-card__price-row">
                                            <span class="bader-app-related-card__price"
                                                  t-field="rel.list_price"
                                                  t-options='{"widget": "monetary", "display_currency": pdp_related_currency}'/>
                                            <span class="bader-app-related-card__cta">Explorar</span>
                                        </span>
                                    </span>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
        </xpath>

        <xpath expr="//section[@id='bader_pdp_related']" position="after">
            <section class="bader-app-help-cta" id="bader_pdp_help_cta" aria-label="Contacto de ayuda">
                <div class="bader-app-help-cta__shell">
                    <div class="bader-app-help-cta__content">
                        <span class="bader-app-section-heading__eyebrow">Asesoria comercial</span>
                        <div class="bader-app-help-cta__text">
                            <h3 t-esc="(pdp_persona_copy or {}).get('help_title') or 'Necesitas ayuda para elegir?'"/>
                            <p t-esc="(pdp_persona_copy or {}).get('help_body') or 'Te ayudamos con compatibilidad, stock, financiacion y entrega.'"/>
                        </div>
                    </div>
                    <div class="bader-app-help-cta__aside">
                        <p class="bader-app-help-cta__note">Respuesta por WhatsApp con apoyo comercial y tecnico de Bader.</p>
                        <a class="bader-app-help-cta__button"
                           t-att-href="pdp_whatsapp_url"
                           target="_blank"
                           rel="noopener">
                            <i class="fa fa-whatsapp"/>
                            <t t-esc="(pdp_persona_copy or {}).get('faq_cta_button') or 'Hablar con asesor comercial'"/>
                        </a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <template id="bader_shop_product_carousel_loading"
              inherit_id="website_sale.shop_product_carousel"
              name="Bader Product Carousel Loading"
              priority="40">
        <xpath expr="//div[hasclass('carousel-inner')]" position="replace">
            <div class="carousel-inner h-100">
                <t t-foreach="product_images" t-as="product_image">
                    <div t-attf-class="carousel-item h-100#{' active' if product_image_first else ''}">
                        <div t-if="product_image._name == 'product.image' and product_image.embed_code"
                             class="d-flex align-items-center justify-content-center h-100 ratio ratio-16x9">
                            <t t-out="product_image.embed_code"/>
                        </div>
                        <div t-else="" class="d-flex align-items-center justify-content-center h-100 oe_unmovable">
                            <img class="oe_unmovable product_detail_img mh-100"
                                 t-att-src="website.image_url(product_image, 'image_1024')"
                                 t-att-srcset="'%s 512w, %s 1024w, %s 1920w' % (website.image_url(product_image, 'image_512'), website.image_url(product_image, 'image_1024'), website.image_url(product_image, 'image_1920'))"
                                 sizes="(max-width: 767px) 92vw, (max-width: 1199px) 56vw, 42vw"
                                 t-att-alt="product_image.name or product.name"
                                 t-att-loading="'eager' if product_image_first else 'lazy'"
                                 t-att-decoding="'sync' if product_image_first else 'async'"
                                 t-att-fetchpriority="'high' if product_image_first else 'low'"
                                 width="1024"
                                 height="1024"/>
                        </div>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="bader_carousel_product_indicators_loading"
              inherit_id="website_sale.carousel_product_indicators"
              name="Bader Carousel Indicators Loading"
              priority="40">
        <xpath expr="//ol" position="replace">
            <ol t-if="len(product_images) > 1" t-attf-class="carousel-indicators {{indicators_list_class}} position-static pt-2 pt-lg-0 mx-auto my-0 text-start">
                <li t-foreach="product_images" t-as="product_image"
                    t-attf-class="align-top position-relative {{'active' if product_image_first else ''}}"
                    data-bs-target="#o-carousel-product"
                    t-att-data-bs-slide-to="str(product_image_index)">
                    <img t-att-src="website.image_url(product_image, 'image_128')"
                         t-att-alt="product_image.name or product.name"
                         class="o_image_64_cover"
                         loading="lazy"
                         decoding="async"
                         width="96"
                         height="96"/>
                    <i t-if="product_image._name == 'product.image' and product_image.embed_code" class="fa fa-2x fa-play-circle o_product_video_thumb bg-black-50 text-center"/>
                </li>
            </ol>
        </xpath>
    </template>

</odoo>
