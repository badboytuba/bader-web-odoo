<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Thank You page after CTA form submission -->
    <template id="bader_thankyou" name="Bader Thank You Page">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="bader-hero" style="min-height:500px;">
                    <div class="bader-hero__container">
                        <div style="font-size:4rem; margin-bottom:24px;">
                            <i class="fa fa-check-circle text-green"/>
                        </div>
                        <h1 class="bader-hero__title">
                            <span class="text-green">Gracias</span> por registrarte!
                        </h1>
                        <p class="bader-hero__subtitle">
                            Hemos recibido tu solicitud. Un asesor de Bader se
                            pondra en contacto contigo muy pronto con tu descuento exclusivo.
                        </p>
                        <div class="bader-hero__actions">
                            <a href="/shop" class="btn-bader">
                                <i class="fa fa-shopping-bag"/> Ver Catalogo
                            </a>
                            <a href="/" class="btn-bader-outline">
                                <i class="fa fa-home"/> Volver al Inicio
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
