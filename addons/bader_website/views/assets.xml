<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        NOTE: All SCSS + JS assets are registered via __manifest__.py.
        This template kept empty intentionally to avoid double SCSS compilation.
        The template ID must remain because it exists in the database from prior installs.
    -->
    <template id="bader_website_assets_frontend" name="Bader Website Assets"
              inherit_id="web.assets_frontend" priority="30">
        <xpath expr="." position="inside">
            <!-- Assets loaded via __manifest__.py — no duplicates here -->
        </xpath>
    </template>

</odoo>
