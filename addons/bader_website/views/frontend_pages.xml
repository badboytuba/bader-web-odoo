<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bader_descargas" name="Bader Descargas">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Descargas - Bader Argentina</title>
                <meta name="description" content="Descarga catalogos y documentacion oficial de Bader Argentina en PDF."/>
            </t>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-downloads-hero bader-animate">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-book"/> Centro de Descargas
                            </span>
                            <h1 class="bader-page-hero__title">
                                Catalogos y <span class="text-green">documentacion</span>
                            </h1>
                            <p class="bader-page-hero__subtitle">
                                Archivos PDF oficiales sincronizados con la seleccion del app Bader-AR.
                            </p>
                            <form action="/descargas" method="get" class="bader-downloads-search">
                                <input type="hidden" name="category" t-att-value="selected_category"/>
                                <i class="fa fa-search"/>
                                <input type="text" name="q" placeholder="Buscar catalogos..." t-att-value="search_query"/>
                                <button type="submit" class="btn-bader-sm">Buscar</button>
                            </form>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-downloads-featured-head">
                            <span class="bader-page-hero__badge"><i class="fa fa-star"/> Destacados</span>
                            <span class="bader-downloads-featured-sub">Los mas descargados</span>
                        </div>
                        <div class="bader-page-section__grid bader-page-section__grid--3">
                            <div class="bader-page-card bader-downloads-card bader-downloads-card--featured"
                                 t-foreach="featured_catalogs"
                                 t-as="catalog">
                                <div class="bader-downloads-card__row">
                                    <div class="bader-downloads-card__cover">
                                        <img t-att-src="catalog['image']" t-att-alt="catalog['title']"/>
                                    </div>
                                    <div class="bader-downloads-card__body">
                                        <h3 class="bader-page-card__title" t-esc="catalog['title']"/>
                                        <p class="bader-page-card__text" t-esc="catalog['description']"/>
                                        <p class="bader-downloads-meta">
                                            <span><i class="fa fa-file-text-o"/> <t t-esc="catalog['pages']"/> pags</span>
                                            <span><t t-esc="catalog['year']"/></span>
                                        </p>
                                        <a t-if="catalog['available']"
                                           t-att-href="catalog['download_url']"
                                           target="_blank"
                                           class="btn-bader-sm">
                                            <i class="fa fa-download"/> Descargar PDF
                                        </a>
                                        <span t-else="" class="bader-downloads-soon">
                                            <i class="fa fa-clock-o"/> Proximamente
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--muted bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-downloads-filters">
                            <span class="bader-downloads-filters__label">
                                <i class="fa fa-filter"/> Filtrar:
                            </span>
                            <a t-foreach="categories"
                               t-as="category"
                               t-attf-href="/descargas?category=#{category['id']}"
                               t-attf-class="bader-downloads-filter #{'is-active' if selected_category == category['id'] else ''}">
                                <t t-esc="category['label']"/>
                                <span class="bader-downloads-filter__count" t-esc="category['count']"/>
                            </a>
                        </div>
                        <p class="bader-downloads-results">
                            Mostrando <strong t-esc="len(filtered_catalogs)"/> catalogos
                        </p>

                        <div class="bader-page-section__grid bader-page-section__grid--4" t-if="filtered_catalogs">
                            <div class="bader-page-card bader-downloads-card"
                                 t-foreach="filtered_catalogs"
                                 t-as="catalog">
                                <div class="bader-downloads-card__image-wrap">
                                    <img t-att-src="catalog['image']" t-att-alt="catalog['title']"/>
                                    <span t-if="catalog['featured'] and catalog['available']" class="bader-downloads-badge">
                                        Destacado
                                    </span>
                                    <div t-if="not catalog['available']" class="bader-downloads-overlay">
                                        <span class="bader-downloads-soon">
                                            <i class="fa fa-clock-o"/> Proximamente
                                        </span>
                                    </div>
                                </div>
                                <h3 class="bader-page-card__title" t-esc="catalog['title']"/>
                                <p class="bader-page-card__text" t-esc="catalog['description']"/>
                                <p class="bader-downloads-meta">
                                    <span><i class="fa fa-file-text-o"/> <t t-esc="catalog['pages']"/> pags</span>
                                    <span><t t-esc="catalog['year']"/></span>
                                </p>
                                <div class="bader-downloads-actions">
                                    <a t-if="catalog['available']"
                                       t-att-href="catalog['download_url']"
                                       target="_blank"
                                       class="btn-bader-sm">
                                        <i class="fa fa-download"/> Descargar
                                    </a>
                                    <span t-else="" class="btn btn-secondary disabled">
                                        <i class="fa fa-clock-o"/> Pronto
                                    </span>
                                    <a t-if="catalog['available']"
                                       t-att-href="catalog['download_url']"
                                       target="_blank"
                                       class="btn btn-outline-secondary btn-sm"
                                       title="Ver PDF">
                                        <i class="fa fa-eye"/>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div t-else="" class="bader-page-card text-center">
                            <h3 class="bader-page-card__title">No se encontraron catalogos</h3>
                            <p class="bader-page-card__text">Prueba otro texto de busqueda o categoria.</p>
                            <a href="/descargas" class="btn-bader">Limpiar filtros</a>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--accent bader-animate">
                    <div class="bader-page-section__container text-center">
                        <h2 class="bader-section__title">Necesitas mas informacion?</h2>
                        <p class="bader-section__subtitle">
                            Nuestro equipo puede ayudarte a elegir el equipamiento ideal para tu clinica o laboratorio.
                        </p>
                        <div class="mt-4">
                            <a href="/#contacto" class="btn-bader">Contactar a un asesor</a>
                            <a href="/productos" class="btn btn-outline-secondary ms-2">Ver productos</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_ayuda" name="Bader Ayuda">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Ayuda - Bader Argentina</title>
                <meta name="description" content="Centro de ayuda Bader: garantias, envios, pagos y soporte tecnico."/>
            </t>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-life-ring"/> Ayuda
                            </span>
                            <h1 class="bader-page-hero__title">
                                Centro de <span class="text-green">soporte</span>
                            </h1>
                            <p class="bader-page-hero__subtitle">
                                Preguntas frecuentes y canales de contacto para clientes de Bader Argentina.
                            </p>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-page-section__grid bader-page-section__grid--3">
                            <div class="bader-page-card">
                                <div class="bader-page-card__icon"><i class="fa fa-shield"/></div>
                                <h3 class="bader-page-card__title">Garantias</h3>
                                <p class="bader-page-card__text">Cobertura oficial y condiciones por tipo de equipo.</p>
                            </div>
                            <div class="bader-page-card">
                                <div class="bader-page-card__icon"><i class="fa fa-truck"/></div>
                                <h3 class="bader-page-card__title">Envios</h3>
                                <p class="bader-page-card__text">Tiempos, zonas de entrega y seguimiento de pedidos.</p>
                            </div>
                            <div class="bader-page-card">
                                <div class="bader-page-card__icon"><i class="fa fa-credit-card"/></div>
                                <h3 class="bader-page-card__title">Pagos y cuotas</h3>
                                <p class="bader-page-card__text">Medios de pago y opciones de financiacion vigentes.</p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_terminos" name="Bader Terminos">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Terminos y Condiciones - Bader Argentina</title>
                <meta name="description" content="Terminos y condiciones de uso y compra en Bader Argentina."/>
            </t>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-gavel"/> Legal
                            </span>
                            <h1 class="bader-page-hero__title">
                                Terminos y <span class="text-green">condiciones</span>
                            </h1>
                            <p class="bader-page-hero__subtitle">
                                Condiciones generales de uso del sitio, catalogo y proceso de compra.
                            </p>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-animate">
                    <div class="bader-page-section__container">
                        <article class="bader-page-card">
                            <h2 class="bader-page-card__title">1. Uso del sitio</h2>
                            <p class="bader-page-card__text">
                                El uso de este sitio implica la aceptacion de estas condiciones.
                                Bader puede actualizar contenidos, precios y disponibilidad sin aviso previo.
                            </p>
                            <h2 class="bader-page-card__title">2. Productos y precios</h2>
                            <p class="bader-page-card__text">
                                Las imagenes y descripciones son referenciales. Los precios y promociones
                                pueden variar segun lista vigente, medios de pago y condiciones comerciales.
                            </p>
                            <h2 class="bader-page-card__title">3. Pedidos y facturacion</h2>
                            <p class="bader-page-card__text">
                                La confirmacion de un pedido queda sujeta a validacion de stock, datos
                                de cliente y aprobacion de pago. La facturacion se emite con datos cargados
                                por el comprador en el checkout.
                            </p>
                            <h2 class="bader-page-card__title">4. Garantias y soporte</h2>
                            <p class="bader-page-card__text">
                                Las garantias aplican segun fabricante y tipo de equipo. Para soporte
                                tecnico y postventa, el cliente puede usar la pagina de servicios o
                                canales de contacto oficiales.
                            </p>
                        </article>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_privacidad" name="Bader Privacidad">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Politica de Privacidad - Bader Argentina</title>
                <meta name="description" content="Politica de privacidad y tratamiento de datos personales de Bader Argentina."/>
            </t>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-user-secret"/> Privacidad
                            </span>
                            <h1 class="bader-page-hero__title">
                                Politica de <span class="text-green">privacidad</span>
                            </h1>
                            <p class="bader-page-hero__subtitle">
                                Informacion sobre como recopilamos, usamos y protegemos tus datos.
                            </p>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-animate">
                    <div class="bader-page-section__container">
                        <article class="bader-page-card">
                            <h2 class="bader-page-card__title">Datos que recopilamos</h2>
                            <p class="bader-page-card__text">
                                Podemos recopilar datos de contacto, identificacion fiscal y datos
                                de compra para procesar pedidos, facturas y soporte al cliente.
                            </p>
                            <h2 class="bader-page-card__title">Finalidad del tratamiento</h2>
                            <p class="bader-page-card__text">
                                Usamos la informacion para gestionar operaciones comerciales, mejorar
                                el servicio, responder consultas y enviar comunicaciones relacionadas
                                con productos o servicios de Bader.
                            </p>
                            <h2 class="bader-page-card__title">Proteccion y conservacion</h2>
                            <p class="bader-page-card__text">
                                Aplicamos medidas tecnicas y organizativas para proteger los datos
                                personales y los conservamos el tiempo necesario para cumplir
                                obligaciones legales y contractuales.
                            </p>
                            <h2 class="bader-page-card__title">Derechos del usuario</h2>
                            <p class="bader-page-card__text">
                                El usuario puede solicitar acceso, rectificacion o actualizacion
                                de sus datos a traves de los canales oficiales de contacto.
                            </p>
                        </article>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_cookies" name="Bader Cookies">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Politica de Cookies - Bader Argentina</title>
                <meta name="description" content="Informacion sobre el uso de cookies en el sitio web de Bader Argentina."/>
            </t>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-circle-o-notch"/> Cookies
                            </span>
                            <h1 class="bader-page-hero__title">
                                Politica de <span class="text-green">cookies</span>
                            </h1>
                            <p class="bader-page-hero__subtitle">
                                Uso de cookies para navegacion, seguridad y mejora de experiencia.
                            </p>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-animate">
                    <div class="bader-page-section__container">
                        <article class="bader-page-card">
                            <h2 class="bader-page-card__title">Que son las cookies</h2>
                            <p class="bader-page-card__text">
                                Las cookies son pequenos archivos de texto que se guardan en el navegador
                                para recordar preferencias, mantener sesiones y analizar uso del sitio.
                            </p>
                            <h2 class="bader-page-card__title">Tipos de cookies utilizadas</h2>
                            <p class="bader-page-card__text">
                                Utilizamos cookies tecnicas para funcionamiento del sitio,
                                cookies de rendimiento para analitica y cookies funcionales
                                para recordar configuraciones de usuario.
                            </p>
                            <h2 class="bader-page-card__title">Gestion de cookies</h2>
                            <p class="bader-page-card__text">
                                Puedes configurar o eliminar cookies desde tu navegador.
                                Algunas funciones pueden verse afectadas si desactivas cookies esenciales.
                            </p>
                        </article>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_blog" name="Bader Blog">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Blog - Bader Argentina</title>
                <meta name="description" content="Articulos, guias y contenido profesional para clinicas, laboratorios y estudiantes."/>
            </t>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-rss"/> Blog Bader
                            </span>
                            <h1 class="bader-page-hero__title">
                                Contenido para <span class="text-green">profesionales</span>
                            </h1>
                            <p class="bader-page-hero__subtitle">
                                Novedades de productos, recomendaciones tecnicas y guias para potenciar tu practica.
                            </p>
                            <form action="/blog" method="get" class="bader-downloads-search bader-blog-search">
                                <input type="hidden" name="category" t-att-value="selected_category"/>
                                <i class="fa fa-search"/>
                                <input type="text" name="q" placeholder="Buscar articulos..." t-att-value="search_query"/>
                                <button type="submit" class="btn-bader-sm">Buscar</button>
                            </form>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-downloads-filters bader-blog-filters">
                            <span class="bader-downloads-filters__label">
                                <i class="fa fa-filter"/> Categorias:
                            </span>
                            <a t-foreach="categories"
                               t-as="category"
                               t-attf-href="/blog?category=#{category['id']}&amp;q=#{search_query}"
                               t-attf-class="bader-downloads-filter #{'is-active' if selected_category == category['id'] else ''}">
                                <t t-esc="category['label']"/>
                                <span class="bader-downloads-filter__count" t-esc="category['count']"/>
                            </a>
                        </div>

                        <p class="bader-downloads-results" t-if="blog_enabled">
                            Mostrando <strong t-esc="len(post_cards)"/> de <strong t-esc="total_posts"/> articulos
                        </p>

                        <div class="bader-page-section__grid bader-page-section__grid--3" t-if="blog_enabled and post_cards">
                            <article class="bader-page-card bader-blog-card"
                                     t-foreach="post_cards"
                                     t-as="card">
                                <a t-att-href="card['url']" class="bader-blog-card__image-link">
                                    <img t-att-src="card['cover_url']"
                                         t-att-alt="card['title']"
                                         class="bader-blog-card__image"/>
                                </a>

                                <div class="bader-blog-card__meta">
                                    <span><i class="fa fa-tag"/> <t t-esc="card['category']"/></span>
                                    <span><i class="fa fa-clock-o"/> <t t-esc="card['read_minutes']"/> min</span>
                                </div>

                                <h3 class="bader-page-card__title">
                                    <a t-att-href="card['url']"><t t-esc="card['title']"/></a>
                                </h3>
                                <p class="bader-page-card__text" t-esc="card['excerpt']"/>

                                <div class="bader-blog-card__footer">
                                    <span class="bader-blog-card__date">
                                        <i class="fa fa-calendar"/> <t t-esc="card['date_label']"/>
                                    </span>
                                    <span class="bader-blog-card__views">
                                        <i class="fa fa-eye"/> <t t-esc="card['view_count']"/>
                                    </span>
                                </div>
                            </article>
                        </div>

                        <div class="bader-page-card text-center" t-elif="blog_enabled">
                            <h3 class="bader-page-card__title">No se encontraron articulos</h3>
                            <p class="bader-page-card__text">
                                Prueba otro termino de busqueda o cambia la categoria seleccionada.
                            </p>
                            <a href="/blog" class="btn-bader">Limpiar filtros</a>
                        </div>

                        <div class="bader-page-card text-center" t-else="">
                            <h3 class="bader-page-card__title">Modulo de blog no disponible</h3>
                            <p class="bader-page-card__text">
                                Activa el modulo de blog en Odoo para publicar articulos en esta seccion.
                            </p>
                        </div>

                        <div class="bader-blog-pagination" t-if="blog_enabled and page_count &gt; 1">
                            <a t-if="has_prev"
                               t-attf-href="/blog?page=#{prev_page}&amp;category=#{selected_category}&amp;q=#{search_query}"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="fa fa-chevron-left"/> Anterior
                            </a>
                            <span class="bader-blog-pagination__status">
                                Pagina <strong t-esc="page"/> de <strong t-esc="page_count"/>
                            </span>
                            <a t-if="has_next"
                               t-attf-href="/blog?page=#{next_page}&amp;category=#{selected_category}&amp;q=#{search_query}"
                               class="btn btn-outline-secondary btn-sm">
                                Siguiente <i class="fa fa-chevron-right"/>
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_blog_post" name="Bader Blog Post">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate" t-if="post">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-file-text-o"/> <t t-esc="post.blog_id.name or 'Blog'"/>
                            </span>
                            <h1 class="bader-page-hero__title" t-esc="post.name"/>
                            <p class="bader-page-hero__subtitle" t-esc="post_excerpt"/>
                            <p class="bader-page-hero__subtitle bader-blog-post__meta">
                                <span><i class="fa fa-calendar"/> <t t-esc="post_date_label"/></span>
                                <span><i class="fa fa-clock-o"/> <t t-esc="post_read_minutes"/> min</span>
                                <span><i class="fa fa-eye"/> <t t-esc="post.visits or 0"/> vistas</span>
                            </p>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-animate" t-if="post">
                    <div class="bader-page-section__container">
                        <div class="bader-blog-post__cover" t-if="post_cover_url">
                            <img t-att-src="post_cover_url" t-att-alt="post.name"/>
                        </div>
                        <article class="bader-page-card bader-blog-post__content">
                            <div t-raw="post.content"/>
                        </article>

                        <div class="bader-blog-post__actions">
                            <a href="/blog" class="btn btn-outline-secondary">
                                <i class="fa fa-chevron-left"/> Volver al blog
                            </a>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--muted bader-animate"
                         t-if="post and related_cards">
                    <div class="bader-page-section__container">
                        <h2 class="bader-section__title bader-section__title--dark">Articulos relacionados</h2>
                        <div class="bader-page-section__grid bader-page-section__grid--3">
                            <article class="bader-page-card bader-blog-card"
                                     t-foreach="related_cards"
                                     t-as="card">
                                <a t-att-href="card['url']" class="bader-blog-card__image-link">
                                    <img t-att-src="card['cover_url']"
                                         t-att-alt="card['title']"
                                         class="bader-blog-card__image"/>
                                </a>
                                <h3 class="bader-page-card__title">
                                    <a t-att-href="card['url']"><t t-esc="card['title']"/></a>
                                </h3>
                                <p class="bader-page-card__text" t-esc="card['excerpt']"/>
                            </article>
                        </div>
                    </div>
                </section>

                <section class="bader-page-hero bader-animate" t-if="not post">
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-file-text-o"/> Blog
                            </span>
                            <h1 class="bader-page-hero__title">Articulo no encontrado</h1>
                            <p class="bader-page-hero__subtitle">
                                No encontramos un articulo publicado para este enlace.
                            </p>
                            <p class="bader-page-hero__subtitle" style="font-size: 0.95rem;">
                                Slug: <strong t-esc="post_slug"/>
                            </p>
                            <a href="/blog" class="btn-bader">Volver al blog</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_payment_success" name="Bader Payment Success">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-section bader-page-section--muted bader-payment-state bader-payment-state--success bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-payment-state__card">
                            <div class="bader-payment-state__icon">
                                <i class="fa fa-check-circle"/>
                            </div>
                            <h1 class="bader-payment-state__title">Pago exitoso</h1>
                            <p class="bader-payment-state__text">
                                Tu pago fue procesado correctamente. Recibiras un email con los detalles de tu compra.
                            </p>
                            <div class="bader-payment-state__actions">
                                <a href="/" class="btn-bader-outline">Volver al inicio</a>
                                <a href="/productos" class="btn-bader">Ver mas productos</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_payment_failure" name="Bader Payment Failure">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-section bader-page-section--muted bader-payment-state bader-payment-state--failure bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-payment-state__card">
                            <div class="bader-payment-state__icon">
                                <i class="fa fa-times-circle"/>
                            </div>
                            <h1 class="bader-payment-state__title">Pago no procesado</h1>
                            <p class="bader-payment-state__text">
                                Ocurrio un problema al procesar tu pago. Puedes intentarlo nuevamente o contactar a nuestro equipo.
                            </p>
                            <div class="bader-payment-state__actions">
                                <a href="/productos" class="btn-bader">Intentar nuevamente</a>
                                <a href="https://wa.me/5491124522097" target="_blank" class="btn-bader-outline">
                                    WhatsApp
                                </a>
                                <a href="/" class="btn-bader-ghost">Volver al inicio</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_payment_pending" name="Bader Payment Pending">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-section bader-page-section--muted bader-payment-state bader-payment-state--pending bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-payment-state__card">
                            <div class="bader-payment-state__icon">
                                <i class="fa fa-clock-o"/>
                            </div>
                            <h1 class="bader-payment-state__title">Pago pendiente</h1>
                            <p class="bader-payment-state__text">
                                Tu pago esta siendo procesado. Te notificaremos por email cuando se confirme.
                            </p>
                            <p class="bader-payment-state__hint">
                                Los pagos por transferencia o efectivo pueden tardar hasta 48 horas en acreditarse.
                            </p>
                            <div class="bader-payment-state__actions">
                                <a href="/" class="btn-bader">Volver al inicio</a>
                                <a href="mailto:hola@bader.com.ar" class="btn-bader-outline">Contactar por email</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_presupuesto_publico" name="Bader Presupuesto Publico">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge"><i class="fa fa-file-text-o"/> Presupuesto</span>
                            <h1 class="bader-page-hero__title">Enlace de presupuesto</h1>
                            <t t-if="order">
                                <p class="bader-page-hero__subtitle">
                                    Presupuesto encontrado en Odoo para <strong t-esc="order.partner_id.name"/>.
                                </p>
                                <p class="bader-page-hero__subtitle" style="font-size: 0.95rem;">
                                    Nro: <strong t-esc="order.name"/> |
                                    Total:
                                    <strong t-field="order.amount_total"
                                            t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                </p>
                                <a t-att-href="portal_url" class="btn-bader">Ver presupuesto</a>
                            </t>
                            <t t-else="">
                                <p class="bader-page-hero__subtitle">
                                    No encontramos un presupuesto valido para este token.
                                </p>
                                <p class="bader-page-hero__subtitle" style="font-size: 0.95rem;">
                                    Token: <strong t-esc="token"/>
                                </p>
                                <a href="/" class="btn-bader">Volver al inicio</a>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_pago_publico" name="Bader Pago Publico">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge"><i class="fa fa-credit-card"/> Pago</span>
                            <h1 class="bader-page-hero__title">Enlace de pago</h1>
                            <t t-if="order">
                                <p class="bader-page-hero__subtitle">
                                    Pedido encontrado en Odoo. Continua para pagar desde el portal seguro.
                                </p>
                                <p class="bader-page-hero__subtitle" style="font-size: 0.95rem;">
                                    Nro: <strong t-esc="order.name"/> |
                                    Total:
                                    <strong t-field="order.amount_total"
                                            t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                </p>
                                <a t-att-href="portal_url" class="btn-bader">Ir al pago</a>
                            </t>
                            <t t-else="">
                                <p class="bader-page-hero__subtitle">
                                    No encontramos un pedido valido para este enlace de pago.
                                </p>
                                <p class="bader-page-hero__subtitle" style="font-size: 0.95rem;">
                                    Token: <strong t-esc="token"/>
                                </p>
                                <a href="/" class="btn-bader">Volver al inicio</a>
                            </t>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_recuperar_carrito" name="Bader Recuperar Carrito">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge"><i class="fa fa-shopping-cart"/> Recuperar carrito</span>
                            <h1 class="bader-page-hero__title">No fue posible recuperar el carrito</h1>
                            <t t-if="order">
                                <p class="bader-page-hero__subtitle">
                                    El pedido <strong t-esc="order.name"/> no se puede recuperar con esta cuenta o ya no esta en borrador.
                                </p>
                                <a t-if="portal_url" t-att-href="portal_url" class="btn-bader">Ver pedido</a>
                            </t>
                            <t t-else="">
                                <p class="bader-page-hero__subtitle">
                                    No encontramos un carrito valido para este token.
                                </p>
                            </t>
                            <p class="bader-page-hero__subtitle" style="font-size: 0.95rem;">
                                Token: <strong t-esc="token"/>
                            </p>
                            <a href="/productos" class="btn-bader">Ir al catalogo</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
