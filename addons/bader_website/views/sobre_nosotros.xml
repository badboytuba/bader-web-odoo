<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bader_sobre_nosotros" name="Bader Sobre Nosotros">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Sobre Nosotros - Bader Argentina</title>
                <meta name="description" content="Bader Iberoamericana: mas de 30 anos liderando el mercado de equipamiento odontologico. Presencia en 8 paises, mas de 500 distribuidores y certificacion ISO 9001."/>
                <meta property="og:title" content="Sobre Nosotros - Bader Argentina"/>
                <meta property="og:description" content="Mas de 30 anos en equipamiento odontologico. Presencia en 8 paises con mas de 500 distribuidores y mas de 2.800 productos."/>
                <meta property="og:image" content="/bader_website/static/src/img/bader_logotipo.png"/>
                <meta property="og:type" content="website"/>
                <meta property="og:url" t-att-content="request.httprequest.url"/>
                <link rel="canonical" t-att-href="request.httprequest.url"/>
                <meta name="twitter:card" content="summary_large_image"/>
            </t>

            <div id="wrap" class="oe_structure oe_empty bader-about-page">

                <section class="bader-page-hero bader-about__hero bader-animate">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-building"/> Sobre Nosotros
                            </span>
                            <h1 class="bader-page-hero__title">
                                Quienes <span class="text-green">Somos</span>?
                            </h1>
                            <p class="bader-page-hero__subtitle">
                                Somos una empresa espanola que ha expandido su presencia a Argentina,
                                llevando nuestra experiencia en la fabricacion, importacion, exportacion,
                                instalacion y servicio tecnico de material odontologico.
                            </p>

                            <div class="bader-about__hero-stats">
                                <div class="bader-about__hero-stat">
                                    <i class="fa fa-users"/>
                                    <div class="bader-about__hero-stat-value" data-count-to="10000" data-count-suffix="+">10,000+</div>
                                    <div class="bader-about__hero-stat-label">Clientes satisfechos</div>
                                </div>
                                <div class="bader-about__hero-stat">
                                    <i class="fa fa-cubes"/>
                                    <div class="bader-about__hero-stat-value" data-count-to="1300" data-count-suffix="+">1,300+</div>
                                    <div class="bader-about__hero-stat-label">Productos disponibles</div>
                                </div>
                                <div class="bader-about__hero-stat">
                                    <i class="fa fa-globe"/>
                                    <div class="bader-about__hero-stat-value" data-count-to="800" data-count-suffix="+">800+</div>
                                    <div class="bader-about__hero-stat-label">Distribuidores mundiales</div>
                                </div>
                                <div class="bader-about__hero-stat">
                                    <i class="fa fa-star"/>
                                    <div class="bader-about__hero-stat-value" data-count-to="4.7">4.7</div>
                                    <div class="bader-about__hero-stat-label">Google Reviews</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--muted bader-about__mission bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-split">
                            <div class="bader-about__mission-copy">
                                <span class="bader-page-hero__badge bader-about__soft-badge">
                                    Nuestra Mision
                                </span>
                                <h2 class="bader-section__title">
                                    Equipando sonrisas en <span class="text-green">toda Argentina</span>
                                </h2>
                                <p class="bader-about__copy">
                                    Ofrecemos una amplia gama de productos odontologicos, incluyendo equipos dentales,
                                    instrumental rotatorio, materiales para laboratorio protesico y productos para
                                    estudiantes de odontologia.
                                </p>
                                <p class="bader-about__copy">
                                    Con la misma calidad y compromiso que nos han convertido en un referente en Espana,
                                    ahora estamos listos para atender el mercado argentino con soluciones innovadoras
                                    y un soporte especializado.
                                </p>
                                <div class="bader-about__mission-actions">
                                    <a href="/productos" class="btn-bader">Ver productos</a>
                                    <a href="/#contacto" class="btn-bader-outline">Contactarnos</a>
                                </div>
                            </div>

                            <div class="bader-about__values-grid">
                                <div class="bader-about__value-card">
                                    <div class="bader-page-card__icon">
                                        <i class="fa fa-certificate"/>
                                    </div>
                                    <h3 class="bader-page-card__title">Calidad Europea</h3>
                                    <p class="bader-page-card__text">
                                        Productos fabricados con los mas altos estandares de calidad europeos,
                                        garantizando durabilidad y precision.
                                    </p>
                                </div>
                                <div class="bader-about__value-card">
                                    <div class="bader-page-card__icon">
                                        <i class="fa fa-heart"/>
                                    </div>
                                    <h3 class="bader-page-card__title">Compromiso</h3>
                                    <p class="bader-page-card__text">
                                        Nos comprometemos con cada cliente, ofreciendo soluciones personalizadas
                                        y soporte continuo.
                                    </p>
                                </div>
                                <div class="bader-about__value-card">
                                    <div class="bader-page-card__icon">
                                        <i class="fa fa-bullseye"/>
                                    </div>
                                    <h3 class="bader-page-card__title">Innovacion</h3>
                                    <p class="bader-page-card__text">
                                        Constantemente buscamos las ultimas tecnologias para ofrecer equipos
                                        de vanguardia.
                                    </p>
                                </div>
                                <div class="bader-about__value-card">
                                    <div class="bader-page-card__icon">
                                        <i class="fa fa-shield"/>
                                    </div>
                                    <h3 class="bader-page-card__title">Garantia</h3>
                                    <p class="bader-page-card__text">
                                        Respaldamos todos nuestros productos con garantia europea y servicio
                                        tecnico especializado.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-about__timeline-section bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-page-section__heading">
                            <span class="bader-page-hero__badge bader-about__soft-badge">
                                Nuestra Historia
                            </span>
                            <h2 class="bader-section__title">
                                Un camino de <span class="text-green">excelencia</span>
                            </h2>
                        </div>

                        <div class="bader-about__timeline">
                            <div class="bader-about__timeline-line"/>

                            <div class="bader-about__timeline-item bader-about__timeline-item--left bader-animate">
                                <div class="bader-about__timeline-content">
                                    <div class="bader-about__timeline-card">
                                        <span class="bader-about__timeline-year">2008</span>
                                        <h3>Fundacion en Espana</h3>
                                        <p>Bader nace en Espana como empresa especializada en equipamiento odontologico.</p>
                                    </div>
                                </div>
                                <div class="bader-about__timeline-dot">
                                    <i class="fa fa-check"/>
                                </div>
                            </div>

                            <div class="bader-about__timeline-item bader-about__timeline-item--right bader-animate">
                                <div class="bader-about__timeline-dot">
                                    <i class="fa fa-check"/>
                                </div>
                                <div class="bader-about__timeline-content">
                                    <div class="bader-about__timeline-card">
                                        <span class="bader-about__timeline-year">2015</span>
                                        <h3>Expansion Europea</h3>
                                        <p>Consolidamos nuestra presencia en multiples paises europeos con mas de 500 distribuidores.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="bader-about__timeline-item bader-about__timeline-item--left bader-animate">
                                <div class="bader-about__timeline-content">
                                    <div class="bader-about__timeline-card">
                                        <span class="bader-about__timeline-year">2020</span>
                                        <h3>Llegada a Argentina</h3>
                                        <p>Expandimos operaciones a Latinoamerica, estableciendo sede en Buenos Aires.</p>
                                    </div>
                                </div>
                                <div class="bader-about__timeline-dot">
                                    <i class="fa fa-check"/>
                                </div>
                            </div>

                            <div class="bader-about__timeline-item bader-about__timeline-item--right bader-animate">
                                <div class="bader-about__timeline-dot">
                                    <i class="fa fa-check"/>
                                </div>
                                <div class="bader-about__timeline-content">
                                    <div class="bader-about__timeline-card">
                                        <span class="bader-about__timeline-year">2024</span>
                                        <h3>Lideres Regionales</h3>
                                        <p>Nos convertimos en referentes del mercado argentino con mas de 10,000 clientes.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--muted bader-about__lines bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-page-section__heading">
                            <span class="bader-page-hero__badge bader-about__soft-badge">
                                Nuestras Lineas
                            </span>
                            <h2 class="bader-section__title">
                                Productos para cada <span class="text-green">necesidad</span>
                            </h2>
                            <p class="bader-section__subtitle">
                                Ofrecemos una amplia variedad de material odontologico para clinicas,
                                laboratorios, estudiantes y odontopediatria.
                            </p>
                        </div>

                        <div class="bader-page-section__grid bader-page-section__grid--3">
                            <div class="bader-page-card bader-about__line-card bader-animate">
                                <div class="bader-page-card__icon">
                                    <i class="fa fa-wrench"/>
                                </div>
                                <h3 class="bader-page-card__title">Instrumental</h3>
                                <p class="bader-page-card__text">Herramientas de precision para profesionales</p>
                            </div>
                            <div class="bader-page-card bader-about__line-card bader-animate">
                                <div class="bader-page-card__icon">
                                    <i class="fa fa-graduation-cap"/>
                                </div>
                                <h3 class="bader-page-card__title">Formacion</h3>
                                <p class="bader-page-card__text">Fantomas, simuladores y tipodontos</p>
                            </div>
                            <div class="bader-page-card bader-about__line-card bader-animate">
                                <div class="bader-page-card__icon">
                                    <i class="fa fa-bed"/>
                                </div>
                                <h3 class="bader-page-card__title">Mobiliario</h3>
                                <p class="bader-page-card__text">Sillones y muebles para clinicas</p>
                            </div>
                            <div class="bader-page-card bader-about__line-card bader-animate">
                                <div class="bader-page-card__icon">
                                    <i class="fa fa-flask"/>
                                </div>
                                <h3 class="bader-page-card__title">Laboratorio</h3>
                                <p class="bader-page-card__text">Equipos para laboratorios protesicos</p>
                            </div>
                            <div class="bader-page-card bader-about__line-card bader-animate">
                                <div class="bader-page-card__icon">
                                    <i class="fa fa-camera"/>
                                </div>
                                <h3 class="bader-page-card__title">Fotografia</h3>
                                <p class="bader-page-card__text">Equipos de fotografia dental</p>
                            </div>
                            <div class="bader-page-card bader-about__line-card bader-animate">
                                <div class="bader-page-card__icon">
                                    <i class="fa fa-cubes"/>
                                </div>
                                <h3 class="bader-page-card__title">Accesorios</h3>
                                <p class="bader-page-card__text">Complementos y consumibles</p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--accent bader-about__benefits bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-about__benefits-bar">
                            <div class="bader-about__benefit-item">
                                <div class="bader-about__benefit-icon">
                                    <i class="fa fa-truck"/>
                                </div>
                                <span>Entregas en CABA en el dia</span>
                            </div>
                            <div class="bader-about__benefit-item">
                                <div class="bader-about__benefit-icon">
                                    <i class="fa fa-check-circle"/>
                                </div>
                                <span>10% descuento en efectivo o transferencia</span>
                            </div>
                            <div class="bader-about__benefit-item">
                                <div class="bader-about__benefit-icon">
                                    <i class="fa fa-cubes"/>
                                </div>
                                <span>Envio gratis a partir de $200.000</span>
                            </div>
                            <div class="bader-about__benefit-item">
                                <div class="bader-about__benefit-icon">
                                    <i class="fa fa-globe"/>
                                </div>
                                <span>Entregas en todo el pais despachadas en el dia</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--white bader-about__global bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-split">
                            <div class="bader-about__global-copy">
                                <span class="bader-page-hero__badge bader-about__soft-badge">
                                    <i class="fa fa-globe"/> Presencia Global
                                </span>
                                <h2 class="bader-section__title">
                                    Queres vender <span class="text-green">nuestros productos</span>?
                                </h2>
                                <p class="bader-about__copy">
                                    Tenemos una gran variedad de material odontologico para: Clinica dental,
                                    Laboratorio de protesis, Estudiantes y Odontopediatria.
                                </p>
                                <p class="bader-about__copy">
                                    Olvidate de las roturas de stock. Siempre tendras lo que tus clientes necesitan.
                                </p>

                                <div class="bader-about__stat-row">
                                    <div class="bader-about__stat-item">
                                        <div class="bader-about__stat-big">800+</div>
                                        <div class="bader-about__stat-desc">Distribuidores</div>
                                    </div>
                                    <div class="bader-about__stat-divider"/>
                                    <div class="bader-about__stat-item">
                                        <div class="bader-about__stat-big">15+</div>
                                        <div class="bader-about__stat-desc">Paises</div>
                                    </div>
                                    <div class="bader-about__stat-divider"/>
                                    <div class="bader-about__stat-item">
                                        <div class="bader-about__stat-big">16+</div>
                                        <div class="bader-about__stat-desc">Anos</div>
                                    </div>
                                </div>

                                <a href="/ser-distribuidor" class="btn-bader btn-bader--lg bader-about__global-cta">
                                    <i class="fa fa-map-marker"/> Quiero ser distribuidor
                                </a>
                            </div>

                            <div class="bader-about__distributor-card">
                                <h3>Beneficios para distribuidores</h3>
                                <ul class="bader-checklist">
                                    <li><i class="fa fa-check-circle"/> <span>Precios exclusivos para mayoristas</span></li>
                                    <li><i class="fa fa-check-circle"/> <span>Stock garantizado sin roturas</span></li>
                                    <li><i class="fa fa-check-circle"/> <span>Material de marketing incluido</span></li>
                                    <li><i class="fa fa-check-circle"/> <span>Capacitacion y soporte tecnico</span></li>
                                    <li><i class="fa fa-check-circle"/> <span>Financiacion flexible</span></li>
                                    <li><i class="fa fa-check-circle"/> <span>Envios prioritarios</span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-page-section bader-page-section--green bader-about__cta bader-animate">
                    <div class="bader-page-section__container">
                        <h2 class="bader-about__cta-title">
                            Listo para equipar tu clinica?
                        </h2>
                        <p class="bader-about__cta-subtitle">
                            Contacta con nuestro equipo de especialistas y encuentra las mejores
                            soluciones para tu practica profesional.
                        </p>
                        <div class="bader-about__cta-actions">
                            <a href="/#contacto" class="btn-bader bader-about__cta-primary">
                                Contactar ahora
                            </a>
                            <a href="/descargas" class="btn-bader-outline bader-about__cta-secondary">
                                Ver catalogos
                            </a>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

</odoo>
