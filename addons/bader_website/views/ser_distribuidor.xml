<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bader_ser_distribuidor" name="Bader Ser Distribuidor">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Ser Distribuidor Bader - Oportunidad de Negocio</title>
                <meta name="description" content="Convertite en distribuidor oficial Bader. Margenes atractivos, linea completa de productos, soporte tecnico y marketing."/>
                <meta property="og:title" content="Ser Distribuidor Bader - Oportunidad de Negocio"/>
                <meta property="og:description" content="Sumate a la red de distribuidores Bader en Argentina. Condiciones comerciales competitivas y soporte integral."/>
                <meta property="og:image" content="/bader_website/static/src/img/bader_logotipo.png"/>
                <meta property="og:type" content="website"/>
                <meta property="og:url" t-att-content="request.httprequest.url"/>
                <link rel="canonical" t-att-href="request.httprequest.url"/>
                <meta name="twitter:card" content="summary_large_image"/>
            </t>

            <div id="wrap" class="oe_structure oe_empty bader-dist-page">

                <section class="bader-dist-hero bader-animate">
                    <div class="bader-dist-hero__glow bader-dist-hero__glow--a"/>
                    <div class="bader-dist-hero__glow bader-dist-hero__glow--b"/>
                    <div class="bader-page-section__container bader-dist-hero__container">
                        <div class="bader-dist-hero__grid">
                            <div class="bader-dist-hero__content">
                                <span class="bader-dist-badge">
                                    <i class="fa fa-handshake-o"/> Programa de Distribuidores
                                </span>
                                <h1 class="bader-dist-hero__title">
                                    Potencia tu negocio con <span class="text-green">Bader</span>
                                </h1>
                                <p class="bader-dist-hero__lead">
                                    Somos entusiastas y nos mueve lo que hacemos, por eso cada dia obtenemos mejores resultados.
                                </p>
                                <p class="bader-dist-hero__text">
                                    Queres ser distribuidor de material dental y aumentar tus rendimientos?
                                    Gracias a nuestro crecimiento, ofrecemos condiciones comerciales competitivas,
                                    con apoyo comercial y logistico en todo el pais.
                                </p>

                                <div class="bader-dist-metrics">
                                    <div class="bader-dist-metric">
                                        <div class="bader-dist-metric__icon">
                                            <i class="fa fa-line-chart"/>
                                        </div>
                                        <div class="bader-dist-metric__info">
                                            <strong>800+</strong>
                                            <span>Distribuidores</span>
                                        </div>
                                    </div>
                                    <div class="bader-dist-metric">
                                        <div class="bader-dist-metric__icon">
                                            <i class="fa fa-users"/>
                                        </div>
                                        <div class="bader-dist-metric__info">
                                            <strong>10,000+</strong>
                                            <span>Clientes</span>
                                        </div>
                                    </div>
                                    <div class="bader-dist-metric">
                                        <div class="bader-dist-metric__icon">
                                            <i class="fa fa-cubes"/>
                                        </div>
                                        <div class="bader-dist-metric__info">
                                            <strong>1,300+</strong>
                                            <span>Productos</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bader-dist-hero__media">
                                <div class="bader-dist-media-card">
                                    <img src="https://bader.com.ar/web/image/8239-8239b47d/woman-handshaking-outdoors-modern-glass-business-building-close-up-picture%20%281%29.jpg"
                                         alt="Distribuidor Bader" loading="lazy"/>

                                    <div class="bader-dist-float bader-dist-float--top">
                                        <div class="bader-dist-float__dots">
                                            <span>1</span>
                                            <span>2</span>
                                            <span>3</span>
                                        </div>
                                        <div class="bader-dist-float__meta">
                                            <strong>+10,000</strong>
                                            <small>Clientes felices</small>
                                        </div>
                                    </div>

                                    <div class="bader-dist-float bader-dist-float--left">
                                        <div class="bader-dist-float__dots">
                                            <span>1</span>
                                            <span>2</span>
                                            <span>3</span>
                                        </div>
                                        <div class="bader-dist-float__meta">
                                            <strong>+1,300</strong>
                                            <small>Productos</small>
                                        </div>
                                    </div>

                                    <div class="bader-dist-float bader-dist-float--bottom">
                                        <div class="bader-dist-float__dots">
                                            <span>4</span>
                                            <span>.</span>
                                            <span>7</span>
                                        </div>
                                        <div class="bader-dist-float__meta">
                                            <strong><i class="fa fa-star"/> 4.7</strong>
                                            <small>Google Reviews</small>
                                        </div>
                                    </div>

                                    <div class="bader-dist-brand">
                                        <span class="bader-dist-brand__logo">
                                            <i class="fa fa-star"/>
                                        </span>
                                        <div>
                                            <strong>BADER</strong>
                                            <small>Iberoamericana</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-dist-section bader-dist-section--muted bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-dist-heading">
                            <span class="bader-dist-badge bader-dist-badge--soft">Beneficios Exclusivos</span>
                            <h2>Por que ser <span class="text-green">distribuidor Bader</span>?</h2>
                            <p>Ofrecemos las mejores condiciones comerciales y apoyo integral para que tu negocio crezca.</p>
                        </div>

                        <div class="bader-dist-benefits-grid">
                            <article class="bader-dist-benefit-card bader-animate">
                                <div class="bader-dist-benefit-card__icon"><i class="fa fa-wrench"/></div>
                                <h3>Tecnicos</h3>
                                <p>Servicio tecnico especializado para todos nuestros productos.</p>
                            </article>
                            <article class="bader-dist-benefit-card bader-animate">
                                <div class="bader-dist-benefit-card__icon"><i class="fa fa-cube"/></div>
                                <h3>100% Stock</h3>
                                <p>Alta disponibilidad para evitar roturas de stock en tu negocio.</p>
                            </article>
                            <article class="bader-dist-benefit-card bader-animate">
                                <div class="bader-dist-benefit-card__icon"><i class="fa fa-truck"/></div>
                                <h3>Envios 24h</h3>
                                <p>Despachos agiles para que tus clientes reciban sus pedidos rapido.</p>
                            </article>
                            <article class="bader-dist-benefit-card bader-animate">
                                <div class="bader-dist-benefit-card__icon"><i class="fa fa-headphones"/></div>
                                <h3>Postventa</h3>
                                <p>Acompanamiento y soluciones antes y despues de cada venta.</p>
                            </article>
                            <article class="bader-dist-benefit-card bader-animate">
                                <div class="bader-dist-benefit-card__icon"><i class="fa fa-bullhorn"/></div>
                                <h3>Marketing</h3>
                                <p>Material grafico, fotos, videos y recursos comerciales listos para usar.</p>
                            </article>
                            <article class="bader-dist-benefit-card bader-animate">
                                <div class="bader-dist-benefit-card__icon"><i class="fa fa-shield"/></div>
                                <h3>Garantia</h3>
                                <p>Todos los productos cuentan con garantia oficial de fabricante.</p>
                            </article>
                        </div>
                    </div>
                </section>

                <section class="bader-dist-section bader-dist-section--accent bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-dist-heading bader-dist-heading--light">
                            <span class="bader-dist-badge">Nuestro Catalogo</span>
                            <h2>Nuestras lineas de <span class="text-green">productos</span></h2>
                            <p>Variedad de material odontologico para todos los segmentos y necesidades.</p>
                        </div>

                        <div class="bader-dist-lines-grid">
                            <div class="bader-dist-line-card"><span><i class="fa fa-graduation-cap"/></span><h3>Formacion</h3></div>
                            <div class="bader-dist-line-card"><span><i class="fa fa-wrench"/></span><h3>Instrumental</h3></div>
                            <div class="bader-dist-line-card"><span><i class="fa fa-cube"/></span><h3>Mobiliario</h3></div>
                            <div class="bader-dist-line-card"><span><i class="fa fa-flask"/></span><h3>Laboratorio</h3></div>
                            <div class="bader-dist-line-card"><span><i class="fa fa-camera"/></span><h3>Fotografia</h3></div>
                            <div class="bader-dist-line-card"><span><i class="fa fa-archive"/></span><h3>Accesorios</h3></div>
                        </div>
                    </div>
                </section>

                <section id="form" class="bader-dist-section bader-dist-section--white bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-dist-form-layout">
                            <div class="bader-dist-form-copy">
                                <span class="bader-dist-badge bader-dist-badge--soft">
                                    <i class="fa fa-building-o"/> Unite al equipo
                                </span>
                                <h2>Unite al equipo de <span class="text-green">BADER</span></h2>
                                <p>
                                    Una vez cubierto el formulario, uno de nuestros comerciales se pondra en contacto
                                    contigo para compartir toda la informacion necesaria y empezar a trabajar juntos.
                                </p>
                                <p class="bader-dist-form-copy__lead">
                                    Estas a un paso de ser distribuidor de material dental de BADER.
                                </p>
                                <ul class="bader-checklist">
                                    <li><i class="fa fa-check-circle"/> Precios exclusivos para mayoristas</li>
                                    <li><i class="fa fa-check-circle"/> Stock garantizado sin roturas</li>
                                    <li><i class="fa fa-check-circle"/> Material de marketing incluido</li>
                                    <li><i class="fa fa-check-circle"/> Capacitacion y soporte tecnico</li>
                                    <li><i class="fa fa-check-circle"/> Financiacion flexible</li>
                                    <li><i class="fa fa-check-circle"/> Envios prioritarios a todo el pais</li>
                                </ul>
                            </div>

                            <div class="bader-form bader-dist-form-card">
                                <h3 class="bader-form__title">Formulario de Contacto</h3>
                                <p class="bader-form__subtitle">Completa tus datos y te contactaremos</p>
                                <form action="/bader/distribuidor-form" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
                                        <input type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                                    </div>

                                    <div class="bader-form__group">
                                        <label>Nombre completo *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-user"/>
                                            <input type="text" name="name" placeholder="Tu nombre" required="required"/>
                                        </div>
                                    </div>

                                    <div class="bader-form__group">
                                        <label>Correo electronico *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-envelope"/>
                                            <input type="email" name="email" placeholder="tu@email.com" required="required"/>
                                        </div>
                                    </div>

                                    <div class="bader-form__group">
                                        <label>Empresa *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-building"/>
                                            <input type="text" name="company" placeholder="Nombre de tu empresa" required="required"/>
                                        </div>
                                    </div>

                                    <div class="bader-form__group">
                                        <label>Telefono *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-phone"/>
                                            <input type="tel" name="phone" placeholder="+54 11 1234-5678" required="required"/>
                                        </div>
                                    </div>

                                    <div class="bader-form-grid">
                                        <div class="bader-form__group">
                                            <label>Ciudad</label>
                                            <div class="input-wrapper">
                                                <i class="fa fa-map-marker"/>
                                                <input type="text" name="city" placeholder="Tu ciudad"/>
                                            </div>
                                        </div>
                                        <div class="bader-form__group">
                                            <label>Provincia</label>
                                            <div class="input-wrapper">
                                                <i class="fa fa-map-marker"/>
                                                <select name="province">
                                                    <option value="">Seleccionar</option>
                                                    <option value="Buenos Aires">Buenos Aires</option>
                                                    <option value="Ciudad Autonoma de Buenos Aires">Ciudad Autonoma de Buenos Aires</option>
                                                    <option value="Catamarca">Catamarca</option>
                                                    <option value="Chaco">Chaco</option>
                                                    <option value="Chubut">Chubut</option>
                                                    <option value="Cordoba">Cordoba</option>
                                                    <option value="Corrientes">Corrientes</option>
                                                    <option value="Entre Rios">Entre Rios</option>
                                                    <option value="Formosa">Formosa</option>
                                                    <option value="Jujuy">Jujuy</option>
                                                    <option value="La Pampa">La Pampa</option>
                                                    <option value="La Rioja">La Rioja</option>
                                                    <option value="Mendoza">Mendoza</option>
                                                    <option value="Misiones">Misiones</option>
                                                    <option value="Neuquen">Neuquen</option>
                                                    <option value="Rio Negro">Rio Negro</option>
                                                    <option value="Salta">Salta</option>
                                                    <option value="San Juan">San Juan</option>
                                                    <option value="San Luis">San Luis</option>
                                                    <option value="Santa Cruz">Santa Cruz</option>
                                                    <option value="Santa Fe">Santa Fe</option>
                                                    <option value="Santiago del Estero">Santiago del Estero</option>
                                                    <option value="Tierra del Fuego">Tierra del Fuego</option>
                                                    <option value="Tucuman">Tucuman</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="bader-form__group">
                                        <label>Mensaje (opcional)</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-comment" style="top: 1rem;"/>
                                            <textarea name="message" placeholder="Contanos sobre tu negocio..." rows="4"></textarea>
                                        </div>
                                    </div>

                                    <button type="submit" class="bader-form__submit">
                                        Enviar solicitud <i class="fa fa-arrow-right"/>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="bader-dist-section bader-dist-section--cta bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-dist-cta">
                            <div>
                                <h2>Tenes dudas?</h2>
                                <p>Contacta con nuestro equipo comercial para mas informacion.</p>
                            </div>
                            <div class="bader-dist-cta__actions">
                                <a href="https://wa.me/5491124522097" target="_blank" class="btn-bader">
                                    <i class="fa fa-whatsapp"/> WhatsApp
                                </a>
                                <a href="/productos" class="btn-bader-outline">
                                    Ver tienda online <i class="fa fa-arrow-right"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="bader_distribuidor_gracias" name="Bader Distribuidor Gracias">
        <t t-call="website.layout">
            <div id="wrap" class="bader-dist-thankyou-wrap">
                <section class="bader-dist-thankyou">
                    <div class="bader-page-section__container">
                        <div class="bader-dist-thankyou__card">
                            <span class="bader-dist-thankyou__icon"><i class="fa fa-check-circle"/></span>
                            <h1>Solicitud enviada</h1>
                            <p>
                                Gracias por tu interes en ser distribuidor Bader.
                                Nuestro equipo comercial se pondra en contacto contigo muy pronto.
                            </p>
                            <div class="bader-dist-thankyou__actions">
                                <a href="/ser-distribuidor" class="btn-bader-outline">Enviar otra solicitud</a>
                                <a href="/productos" class="btn-bader">Ver catalogo</a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
