<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================
         SERVICIOS — Services page
         Matches Bader-AR Servicios.tsx structure
         6 service cards + service request form
         ==================================================== -->
    <template id="bader_servicios" name="Bader Servicios">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Servicios — Bader Argentina</title>
                <meta name="description" content="Servicio técnico oficial Bader: reparación, mantenimiento preventivo, instalación, calibración. Técnicos certificados, repuestos originales y soporte remoto."/>
                <meta property="og:title" content="Servicios Técnicos — Bader Argentina"/>
                <meta property="og:description" content="Servicio técnico oficial con técnicos certificados. Reparación, mantenimiento, instalación y calibración de equipamiento odontológico."/>
                <meta property="og:image" content="/bader_website/static/src/img/bader_logotipo.png"/>
                <meta property="og:type" content="website"/>
                <meta property="og:url" t-att-content="request.httprequest.url"/>
                <link rel="canonical" t-att-href="request.httprequest.url"/>
                <meta name="twitter:card" content="summary_large_image"/>
            </t>
            <div id="wrap" class="oe_structure oe_empty bader-services-page" data-bader-services-page="1">

                <!-- ============================
                     HERO — Dark accent bg
                     ============================ -->
                <section class="bader-page-hero bader-animate">
                    <div class="bader-page-hero__blur bader-page-hero__blur--1"/>
                    <div class="bader-page-hero__blur bader-page-hero__blur--2"/>
                    <div class="bader-page-hero__container">
                        <div class="bader-page-hero__center">
                            <span class="bader-page-hero__badge">
                                <i class="fa fa-magic"/> Servicios Exclusivos
                            </span>
                            <h1 class="bader-page-hero__title">
                                Servicios <span class="text-green">Bader</span>
                            </h1>
                            <p class="bader-page-hero__subtitle">
                                Te acompanamos en cada paso, desde la asesoria hasta la instalacion.
                                Nuestro equipo experto esta para ayudarte.
                            </p>
                            <div class="bader-services-hero-pills" role="list" aria-label="Beneficios de servicio">
                                <span class="bader-services-hero-pill" role="listitem"><i class="fa fa-phone"/> Atencion personalizada</span>
                                <span class="bader-services-hero-pill" role="listitem"><i class="fa fa-calendar"/> Agenda online</span>
                                <span class="bader-services-hero-pill" role="listitem"><i class="fa fa-headphones"/> Soporte continuo</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============================
                     SERVICES GRID — Muted bg
                     ============================ -->
                <section class="bader-page-section bader-page-section--muted bader-animate">
                    <div class="bader-page-section__container">
                        <div class="bader-page-section__heading">
                            <span class="bader-page-hero__badge" style="background: rgba(112,212,75,0.10);">
                                <i class="fa fa-cogs"/> Que ofrecemos
                            </span>
                            <h2 class="bader-section__title">
                                Servicios <span class="text-green">Bader</span>
                            </h2>
                            <p class="bader-section__subtitle">
                                Haz click en cualquier servicio para abrir el formulario segmentado.
                            </p>
                        </div>

                        <div class="bader-page-section__grid bader-page-section__grid--3">
                            <!-- Service 1: Nancy Asesora -->
                            <div class="bader-services__card bader-page-card bader-animate is-clickable" tabindex="0" role="button" data-service-type="nancy_asesora" data-service-title="Nancy Asesora Virtual" data-service-description="Conecta con especialistas por videollamada para elegir tu equipamiento ideal." data-service-icon="fa-video-camera">
                                <div class="bader-gradient-icon bader-gradient-icon--blue">
                                    <i class="fa fa-video-camera"/>
                                </div>
                                <h3 class="bader-page-card__title" style="margin-top: 1rem;">Nancy Asesora Virtual</h3>
                                <p class="bader-page-card__text">
                                    Conecta con nuestros especialistas por videollamada para asesoramiento personalizado.
                                </p>
                                <ul class="bader-services__features">
                                    <li><i class="fa fa-check"/> Asesoramiento personalizado</li>
                                    <li><i class="fa fa-check"/> Demostraciones en vivo</li>
                                    <li><i class="fa fa-check"/> Sin costo ni compromiso</li>
                                </ul>
                                <button type="button" class="btn-bader-sm bader-services__cta js-bader-service-open">Solicitar</button>
                            </div>

                            <!-- Service 2: Visita Tecnica -->
                            <div class="bader-services__card bader-page-card bader-animate is-clickable" tabindex="0" role="button" data-service-type="visita_tecnica" data-service-title="Visita Tecnica Comercial" data-service-description="Nuestro equipo te visita para una demostracion presencial y propuesta a medida." data-service-icon="fa-car">
                                <div class="bader-gradient-icon bader-gradient-icon--purple">
                                    <i class="fa fa-car"/>
                                </div>
                                <h3 class="bader-page-card__title" style="margin-top: 1rem;">Visita Tecnica Comercial</h3>
                                <p class="bader-page-card__text">
                                    Demostracion presencial en tu clinica, evaluacion de espacio y recomendaciones.
                                </p>
                                <ul class="bader-services__features">
                                    <li><i class="fa fa-check"/> Demostracion in situ</li>
                                    <li><i class="fa fa-check"/> Evaluacion de espacio</li>
                                    <li><i class="fa fa-check"/> Propuesta personalizada</li>
                                </ul>
                                <button type="button" class="btn-bader-sm bader-services__cta js-bader-service-open">Solicitar</button>
                            </div>

                            <!-- Service 3: Servicio Tecnico -->
                            <div class="bader-services__card bader-page-card bader-animate is-clickable" tabindex="0" role="button" data-service-type="servicio_tecnico" data-service-title="Servicio Tecnico Premium" data-service-description="Mantenimiento y reparacion con tecnicos certificados y repuestos originales." data-service-icon="fa-wrench">
                                <div class="bader-gradient-icon bader-gradient-icon--orange">
                                    <i class="fa fa-wrench"/>
                                </div>
                                <h3 class="bader-page-card__title" style="margin-top: 1rem;">Servicio Tecnico Premium</h3>
                                <p class="bader-page-card__text">
                                    Mantenimiento preventivo y reparacion de equipos odontologicos con seguimiento.
                                </p>
                                <ul class="bader-services__features">
                                    <li><i class="fa fa-check"/> Tecnicos certificados</li>
                                    <li><i class="fa fa-check"/> Repuestos originales</li>
                                    <li><i class="fa fa-check"/> Garantia de servicio</li>
                                </ul>
                                <button type="button" class="btn-bader-sm bader-services__cta js-bader-service-open">Solicitar</button>
                            </div>

                            <!-- Service 4: Capacitacion -->
                            <div class="bader-services__card bader-page-card bader-animate is-clickable" tabindex="0" role="button" data-service-type="capacitacion" data-service-title="Capacitacion Bader Academy" data-service-description="Cursos y webinars para aprovechar al maximo tus equipos." data-service-icon="fa-graduation-cap">
                                <div class="bader-gradient-icon bader-gradient-icon--indigo">
                                    <i class="fa fa-graduation-cap"/>
                                </div>
                                <h3 class="bader-page-card__title" style="margin-top: 1rem;">Capacitacion Bader Academy</h3>
                                <p class="bader-page-card__text">
                                    Programas presenciales y online para potenciar tu crecimiento profesional.
                                </p>
                                <ul class="bader-services__features">
                                    <li><i class="fa fa-check"/> Certificados oficiales</li>
                                    <li><i class="fa fa-check"/> Presencial y online</li>
                                    <li><i class="fa fa-check"/> Expertos de la industria</li>
                                </ul>
                                <button type="button" class="btn-bader-sm bader-services__cta js-bader-service-open">Solicitar</button>
                            </div>

                            <!-- Service 5: Financiacion -->
                            <div class="bader-services__card bader-page-card bader-animate is-clickable" tabindex="0" role="button" data-service-type="financiacion" data-service-title="Financiacion Inteligente" data-service-description="Simula cuotas y accede a opciones de financiamiento adaptadas a tu negocio." data-service-icon="fa-credit-card">
                                <div class="bader-gradient-icon bader-gradient-icon--green">
                                    <i class="fa fa-credit-card"/>
                                </div>
                                <h3 class="bader-page-card__title" style="margin-top: 1rem;">Financiacion Inteligente</h3>
                                <p class="bader-page-card__text">
                                    Equipate sin esfuerzo con planes flexibles y aprobacion agil.
                                </p>
                                <ul class="bader-services__features">
                                    <li><i class="fa fa-check"/> Cuotas fijas en pesos</li>
                                    <li><i class="fa fa-check"/> Sin anticipo</li>
                                    <li><i class="fa fa-check"/> Aprobacion rapida</li>
                                </ul>
                                <button type="button" class="btn-bader-sm bader-services__cta js-bader-service-open">Solicitar</button>
                            </div>

                            <!-- Service 6: Instalacion -->
                            <div class="bader-services__card bader-page-card bader-animate is-clickable" tabindex="0" role="button" data-service-type="instalacion" data-service-title="Instalacion Express" data-service-description="Instalacion profesional para que empieces a trabajar de inmediato." data-service-icon="fa-cube">
                                <div class="bader-gradient-icon bader-gradient-icon--teal">
                                    <i class="fa fa-cube"/>
                                </div>
                                <h3 class="bader-page-card__title" style="margin-top: 1rem;">Instalacion Express</h3>
                                <p class="bader-page-card__text">
                                    Instalacion profesional de tus equipos para que operes en 24-48h.
                                </p>
                                <ul class="bader-services__features">
                                    <li><i class="fa fa-check"/> Instalacion en 24-48h</li>
                                    <li><i class="fa fa-check"/> Capacitacion incluida</li>
                                    <li><i class="fa fa-check"/> Garantia de satisfaccion</li>
                                </ul>
                                <button type="button" class="btn-bader-sm bader-services__cta js-bader-service-open">Solicitar</button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============================
                     SERVICE REQUEST FORM — White bg
                     ============================ -->
                <section class="bader-page-section bader-page-section--white bader-animate" id="servicio-form" style="display:none;" aria-hidden="true">
                    <div class="bader-page-section__container">
                        <div class="bader-split">
                            <!-- Left: Info -->
                            <div>
                                <span class="bader-page-hero__badge" style="background: rgba(112,212,75,0.10);">
                                    <i class="fa fa-headphones"/> Solicitar Servicio
                                </span>
                                <h2 class="bader-section__title">
                                    ¿Necesitás <span class="text-green">ayuda</span>?
                                </h2>
                                <p style="color: #475569; margin-bottom: 1.5rem; line-height: 1.7;">
                                    Completá el formulario y nuestro equipo técnico se comunicará con
                                    vos para coordinar el servicio que necesitás.
                                </p>

                                <div class="bader-services__info-items">
                                    <div class="bader-services__info-item">
                                        <div class="bader-about__benefit-icon">
                                            <i class="fa fa-clock-o"/>
                                        </div>
                                        <div>
                                            <strong>Respuesta rápida</strong>
                                            <p style="margin: 0; font-size: 0.85rem; color: #64748B;">Te respondemos en menos de 24hs</p>
                                        </div>
                                    </div>
                                    <div class="bader-services__info-item">
                                        <div class="bader-about__benefit-icon">
                                            <i class="fa fa-certificate"/>
                                        </div>
                                        <div>
                                            <strong>Técnicos certificados</strong>
                                            <p style="margin: 0; font-size: 0.85rem; color: #64748B;">Personal capacitado en fábrica</p>
                                        </div>
                                    </div>
                                    <div class="bader-services__info-item">
                                        <div class="bader-about__benefit-icon">
                                            <i class="fa fa-map-marker"/>
                                        </div>
                                        <div>
                                            <strong>Cobertura nacional</strong>
                                            <p style="margin: 0; font-size: 0.85rem; color: #64748B;">Servicio en todo el país</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Form -->
                            <div class="bader-form">
                                <h3 class="bader-form__title">Solicitar servicio</h3>
                                <p class="bader-form__subtitle">
                                    Completá tus datos y un técnico se pondrá en contacto
                                </p>
                                <form action="/bader/servicio-form" method="POST" id="baderServicioLeadForm">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <!-- Honeypot anti-spam: invisible to humans, bots fill it -->
                                    <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
                                        <input type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                                    </div>

                                    <div class="bader-form-grid">
                                        <div class="bader-form__group">
                                            <label>Nombre completo *</label>
                                            <div class="input-wrapper">
                                                <i class="fa fa-user"/>
                                                <input type="text" name="name"
                                                       placeholder="Tu nombre" required="required"/>
                                            </div>
                                        </div>
                                        <div class="bader-form__group">
                                            <label>Email *</label>
                                            <div class="input-wrapper">
                                                <i class="fa fa-envelope"/>
                                                <input type="email" name="email"
                                                       placeholder="tu@email.com" required="required"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="bader-form-grid">
                                        <div class="bader-form__group">
                                            <label>Teléfono *</label>
                                            <div class="input-wrapper">
                                                <i class="fa fa-phone"/>
                                                <input type="tel" name="phone"
                                                       placeholder="+54 11 1234 5678" required="required"/>
                                            </div>
                                        </div>
                                        <div class="bader-form__group">
                                            <label>Tipo de servicio *</label>
                                            <div class="input-wrapper">
                                                <i class="fa fa-cog"/>
                                                <select name="service_type" required="required" id="baderServicioType">
                                                    <option value="">Selecciona el servicio</option>
                                                    <option value="nancy_asesora">Nancy Asesora Virtual</option>
                                                    <option value="visita_tecnica">Visita Tecnica Comercial</option>
                                                    <option value="servicio_tecnico">Servicio Tecnico Premium</option>
                                                    <option value="capacitacion">Capacitacion Bader Academy</option>
                                                    <option value="financiacion">Financiacion Inteligente</option>
                                                    <option value="instalacion">Instalacion Express</option>
                                                    <option value="mantenimiento">Mantenimiento Preventivo</option>
                                                    <option value="garantia">Garantia</option>
                                                    <option value="otro">Otro</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="bader-form__group">
                                        <label>Equipo / Producto</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-medkit"/>
                                            <input type="text" name="product"
                                                   placeholder="Nombre o modelo del equipo"/>
                                        </div>
                                    </div>

                                    <div class="bader-form__group">
                                        <label>Descripción del problema o solicitud</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-comment" style="top: 1.15rem;"/>
                                            <textarea name="description"
                                                      placeholder="Describí brevemente tu solicitud..." rows="4"/>
                                        </div>
                                    </div>

                                    <button type="submit" class="bader-form__submit">
                                        <i class="fa fa-paper-plane"/> Solicitar servicio
                                    </button>

                                    <div class="bader-form__footer">
                                        <i class="fa fa-lock"/> Tus datos están protegidos
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="bader-services-modal" id="baderServicesModal" aria-hidden="true">
                    <div class="bader-services-modal__backdrop" data-bader-service-modal-close="1"/>
                    <div class="bader-services-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="baderServiceModalTitle">
                        <button type="button" class="bader-services-modal__close" aria-label="Cerrar" data-bader-service-modal-close="1">
                            <i class="fa fa-times"/>
                        </button>
                        <div class="bader-services-modal__header">
                            <span class="bader-services-modal__icon"><i id="baderServiceModalIcon" class="fa fa-wrench"/></span>
                            <h3 class="bader-form__title" id="baderServiceModalTitle">Servicio</h3>
                            <p class="bader-form__subtitle" id="baderServiceModalDescription">
                                Completa el formulario y te contactaremos pronto.
                            </p>
                        </div>
                        <form action="/bader/servicio-form" method="POST" id="baderServiceModalForm" class="bader-form bader-services-modal__form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="service_type" id="baderServiceTypeInput"/>
                            <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
                                <input type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                            </div>

                            <div class="bader-form__group">
                                <label>Nombre completo *</label>
                                <div class="input-wrapper">
                                    <i class="fa fa-user"/>
                                    <input type="text" name="name" placeholder="Tu nombre" required="required"/>
                                </div>
                            </div>
                            <div class="bader-form-grid">
                                <div class="bader-form__group">
                                    <label>Email *</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-envelope"/>
                                        <input type="email" name="email" placeholder="tu@email.com" required="required"/>
                                    </div>
                                </div>
                                <div class="bader-form__group">
                                    <label>Telefono *</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-phone"/>
                                        <input type="tel" name="phone" placeholder="+54 11 1234 5678" required="required"/>
                                    </div>
                                </div>
                            </div>

                            <div class="bader-services-modal__fields" data-service-fields="nancy_asesora">
                                <div class="bader-form__group">
                                    <label>Fecha y hora preferida *</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-calendar"/>
                                        <input type="datetime-local" name="preferred_datetime" data-service-required="1"/>
                                    </div>
                                </div>
                                <div class="bader-form__group">
                                    <label>Equipo de interes *</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-medkit"/>
                                        <input type="text" name="nancy_equipment_interest" placeholder="Ej: Sillon, CBCT, Autoclave" data-service-required="1"/>
                                    </div>
                                </div>
                                <div class="bader-form__group">
                                    <label>Mensaje</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-comment" style="top: 1.15rem;"/>
                                        <textarea name="message" rows="3" placeholder="Contanos que necesitas..."></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="bader-services-modal__fields" data-service-fields="visita_tecnica">
                                <div class="bader-form__group">
                                    <label>Direccion de la clinica *</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-map-marker"/>
                                        <input type="text" name="clinic_address" placeholder="Direccion completa" data-service-required="1"/>
                                    </div>
                                </div>
                                <div class="bader-form-grid">
                                    <div class="bader-form__group">
                                        <label>Fecha preferida *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-calendar"/>
                                            <input type="date" name="preferred_date" data-service-required="1"/>
                                        </div>
                                    </div>
                                    <div class="bader-form__group">
                                        <label>Equipos de interes *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-medkit"/>
                                            <input type="text" name="visita_equipment_interest" placeholder="Equipos para demostracion" data-service-required="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bader-services-modal__fields" data-service-fields="servicio_tecnico">
                                <div class="bader-form__group">
                                    <label>Tipo de servicio *</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-cog"/>
                                        <select name="technical_service_kind" data-service-required="1">
                                            <option value="">Selecciona una opcion</option>
                                            <option value="mantenimiento">Mantenimiento preventivo</option>
                                            <option value="reparacion">Reparacion</option>
                                            <option value="calibracion">Calibracion</option>
                                            <option value="instalacion">Instalacion</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="bader-form__group">
                                    <label>Equipo *</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-medkit"/>
                                        <input type="text" name="equipment" placeholder="Marca y modelo" data-service-required="1"/>
                                    </div>
                                </div>
                                <div class="bader-form__group">
                                    <label>Descripcion del problema *</label>
                                    <div class="input-wrapper">
                                        <i class="fa fa-comment" style="top: 1.15rem;"/>
                                        <textarea name="problem_description" rows="3" placeholder="Describe el problema" data-service-required="1"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="bader-services-modal__fields" data-service-fields="financiacion">
                                <div class="bader-form-grid">
                                    <div class="bader-form__group">
                                        <label>Valor aproximado *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-money"/>
                                            <select name="approximate_value" data-service-required="1">
                                                <option value="">Selecciona un rango</option>
                                                <option value="hasta-5000">Hasta USD 5.000</option>
                                                <option value="5000-15000">USD 5.000 - 15.000</option>
                                                <option value="15000-30000">USD 15.000 - 30.000</option>
                                                <option value="30000-50000">USD 30.000 - 50.000</option>
                                                <option value="mas-50000">Mas de USD 50.000</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="bader-form__group">
                                        <label>Plazo deseado *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-clock-o"/>
                                            <select name="desired_term" data-service-required="1">
                                                <option value="">Selecciona plazo</option>
                                                <option value="6">6 meses</option>
                                                <option value="12">12 meses</option>
                                                <option value="18">18 meses</option>
                                                <option value="24">24 meses</option>
                                                <option value="36">36 meses</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bader-services-modal__fields" data-service-fields="capacitacion">
                                <div class="bader-form-grid">
                                    <div class="bader-form__group">
                                        <label>Area de interes *</label>
                                        <div class="input-wrapper">
                                            <i class="fa fa-graduation-cap"/>
                                            <select name="area_interest" data-service-required="1">
                                                <option value="">Selecciona area</option>
                                                <option value="sillones">Sillones y unidades dentales</option>
                                                <option value="radiografia">Radiografia y CBCT</option>
                                                <option value="esterilizacion">Esterilizacion y bioseguridad</option>
                                                <option value="laboratorio">Equipos de laboratorio</option>
                                                <option value="instrumental">Instrumental rotatorio</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="bader-form__group">
                                        <label>Nivel *</label>
