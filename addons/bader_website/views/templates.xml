<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
         Bader Checkout + Cart
         Front parity with Bader-AR while preserving Odoo 16 flow.
         ========================================================== -->

    <template id="bader_wizard_checkout" inherit_id="website_sale.wizard_checkout"
              name="Bader Wizard Checkout" priority="30">
        <xpath expr="//div[hasclass('wizard')]" position="attributes">
            <attribute name="class" add="bader-checkout-wizard" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='wizard-step10']/div[hasclass('progress-wizard-steplabel')]" position="replace">
            <div class="text-center progress-wizard-steplabel">Carrito</div>
        </xpath>
        <xpath expr="//div[@id='wizard-step20']/div[hasclass('progress-wizard-steplabel')]" position="replace">
            <div class="text-center progress-wizard-steplabel">Envio y datos</div>
        </xpath>
        <xpath expr="//div[@id='wizard-step40']/div[hasclass('progress-wizard-steplabel')]" position="replace">
            <div class="text-center progress-wizard-steplabel">Pago</div>
        </xpath>
    </template>

    <template id="bader_cart_lines" inherit_id="website_sale.cart_lines"
              name="Bader Cart Lines" priority="30">
        <xpath expr="//div[hasclass('js_cart_lines') and hasclass('alert-info')]" position="replace">
            <div t-if="not website_sale_order or not website_sale_order.website_order_line"
                 class="js_cart_lines bader-empty-cart">
                <div class="bader-empty-cart__content">
                    <i class="fa fa-shopping-bag bader-empty-cart__icon"/>
                    <h1>Tu carrito esta vacio</h1>
                    <p>Agrega productos para continuar con tu compra.</p>
                    <a href="/productos" class="bader-continue-btn">Volver a la tienda</a>
                </div>
            </div>
        </xpath>

        <xpath expr="//table[@id='cart_products']" position="attributes">
            <attribute name="class" add="bader-cart-table" separator=" "/>
        </xpath>
        <xpath expr="//table[@id='cart_products']/tbody//tr" position="attributes">
            <attribute name="class" add="bader-cart-line" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('css_quantity')]" position="attributes">
            <attribute name="class" add="bader-qty-control" separator=" "/>
        </xpath>
        <xpath expr="//input[hasclass('js_quantity')]" position="attributes">
            <attribute name="class" add="bader-qty-input" separator=" "/>
        </xpath>
        <xpath expr="//a[hasclass('js_delete_product')]" position="attributes">
            <attribute name="class" add="bader-remove-line" separator=" "/>
        </xpath>
    </template>

    <template id="bader_cart_page" inherit_id="website_sale.cart"
              name="Bader Cart Page" priority="30">
        <xpath expr="//div[@id='wrap']/div[hasclass('container') and hasclass('oe_website_sale')]" position="attributes">
            <attribute name="class" add="bader-cart-page" separator=" "/>
        </xpath>

        <xpath expr="(//a[hasclass('btn-secondary') and .//span[hasclass('fa-chevron-left')]])[1]" position="replace">
            <a role="button" href="/productos" class="btn btn-secondary mb32">
                <span class="fa fa-chevron-left"/>
                <span>Seguir comprando</span>
            </a>
        </xpath>

        <xpath expr="//a[contains(@t-attf-href, 'redirect_url') and hasclass('btn-primary')]" position="attributes">
            <attribute name="class" add="bader-cart-cta" separator=" "/>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, 'redirect_url') and hasclass('btn-primary')]/t[@t-if='redirect_to_sign_in']/span[1]" position="replace">
            <span>Iniciar sesion</span>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, 'redirect_url') and hasclass('btn-primary')]/t[@t-else='']/span[1]" position="replace">
            <span>Finalizar compra</span>
        </xpath>
    </template>

    <template id="bader_short_cart_summary" inherit_id="website_sale.short_cart_summary"
              name="Bader Short Cart Summary" priority="30">
        <xpath expr="//div[hasclass('card')]" position="attributes">
            <attribute name="class" add="bader-summary-card" separator=" "/>
        </xpath>
        <xpath expr="//h4[hasclass('d-none') and hasclass('d-xl-block')]" position="replace">
            <h4 class="d-none d-xl-block">Resumen del pedido</h4>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, 'redirect_url') and hasclass('btn-secondary')]/t[@t-if='redirect_to_sign_in']/span[1]" position="replace">
            <span>Iniciar sesion</span>
        </xpath>
        <xpath expr="//a[contains(@t-attf-href, 'redirect_url') and hasclass('btn-secondary')]/t[@t-else='']/span[1]" position="replace">
            <span>Finalizar compra</span>
        </xpath>
        <xpath expr="//div[hasclass('card-body')]/div/t[@t-call='website_sale.total']" position="after">
            <div class="bader-checkout-benefits">
                <div class="bader-benefit">
                    <i class="fa fa-shield"/>
                    <span>Garantia europea oficial</span>
                </div>
                <div class="bader-benefit">
                    <i class="fa fa-truck"/>
                    <span>Envio a todo el pais</span>
                </div>
                <div class="bader-benefit">
                    <i class="fa fa-lock"/>
                    <span>Pago 100% seguro</span>
                </div>
            </div>
        </xpath>
    </template>

    <template id="bader_cart_summary" inherit_id="website_sale.cart_summary"
              name="Bader Cart Summary" priority="30">
        <xpath expr="//div[hasclass('card')]" position="attributes">
            <attribute name="class" add="bader-summary-card" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('toggle_summary')]" position="replace">
            <div class="toggle_summary d-xl-none bader-summary-toggle">
                <b>Resumen:</b>
                <span id="amount_total_summary"
                      class="monetary_field"
                      t-field="website_sale_order.amount_total"
                      t-options='{"widget": "monetary", "display_currency": website_sale_order.pricelist_id.currency_id}'/>
                <span class="fa fa-chevron-down fa-border float-end" role="img" aria-label="Details" title="Details"/>
            </div>
        </xpath>
        <xpath expr="//table[@id='cart_products']/thead/tr/th[hasclass('td-img')]" position="replace">
            <th class="border-top-0 td-img">Producto</th>
        </xpath>
        <xpath expr="//table[@id='cart_products']/thead/tr/th[hasclass('td-qty')]" position="replace">
            <th class="border-top-0 td-qty">Cantidad</th>
        </xpath>
        <xpath expr="//table[@id='cart_products']/thead/tr/th[hasclass('td-price')]" position="replace">
            <th class="border-top-0 text-center td-price">Precio</th>
        </xpath>
        <xpath expr="//div[hasclass('alert-info')]" position="replace">
            <div t-if="not website_sale_order or not website_sale_order.website_order_line"
                 class="alert alert-info">
                Tu carrito esta vacio.
            </div>
        </xpath>
    </template>

    <template id="bader_checkout_page" inherit_id="website_sale.checkout"
              name="Bader Checkout Page" priority="30">
        <xpath expr="//div[@id='wrap']/div[hasclass('container') and hasclass('oe_website_sale')]" position="attributes">
            <attribute name="class" add="bader-checkout-page" separator=" "/>
        </xpath>
        <xpath expr="//h3[hasclass('o_page_header')][1]" position="replace">
            <h3 class="o_page_header mt8">Direccion de facturacion</h3>
        </xpath>
        <xpath expr="//h3[hasclass('o_page_header') and contains(., 'Shipping Address')]" position="replace">
            <h3 class="o_page_header mt16 mb4">Direccion de envio</h3>
        </xpath>
        <xpath expr="//a[hasclass('a-submit') and hasclass('btn-secondary') and .//span[contains(., 'Add an address')]]/span[last()]" position="replace">
            <span>Agregar direccion</span>
        </xpath>
        <xpath expr="//a[@href='/shop/cart' and hasclass('btn-secondary')]/span" position="replace">
            <span>Volver al carrito</span>
        </xpath>
        <xpath expr="//a[@href='/shop/confirm_order' and hasclass('btn-primary')]" position="attributes">
            <attribute name="class" add="bader-cart-cta" separator=" "/>
        </xpath>
        <xpath expr="//a[@href='/shop/confirm_order' and hasclass('btn-primary')]/span" position="replace">
            <span>Continuar al pago</span>
        </xpath>
    </template>

    <template id="bader_address_kanban" inherit_id="website_sale.address_kanban"
              name="Bader Address Kanban" priority="30">
        <xpath expr="//a[hasclass('btn') and hasclass('btn-block') and hasclass('btn-primary')]" position="replace">
            <a role="button" href="#" class="btn btn-block btn-primary">
                <i class="fa fa-check"/> Enviar a esta direccion
            </a>
        </xpath>
        <xpath expr="//a[hasclass('btn') and hasclass('btn-block') and hasclass('btn-secondary')]" position="replace">
            <a role="button" href="#" class="btn btn-block btn-secondary">
                Seleccionar direccion
            </a>
        </xpath>
    </template>

    <template id="bader_address_page" inherit_id="website_sale.address"
              name="Bader Address Page" priority="30">
        <xpath expr="//div[@id='wrap']/div[hasclass('container') and hasclass('oe_website_sale')]" position="attributes">
            <attribute name="class" add="bader-address-page" separator=" "/>
        </xpath>

        <xpath expr="//span[contains(., 'Fill in your address')]" position="replace">
            <span t-if="account_on_checkout != 'mandatory'">Completa tus datos</span>
        </xpath>
        <xpath expr="//a[contains(@href, '/web/login?redirect=/shop/checkout') and contains(., 'Sign in')]" position="replace">
            <a t-if="account_on_checkout != 'disabled'" role="button" href="/web/login?redirect=/shop/checkout" style="margin-top: -11px"> Iniciar sesion</a>
        </xpath>
        <xpath expr="//h2[contains(., 'Your Address')]" position="replace">
            <h2 class="o_page_header mt8">Tus datos</h2>
        </xpath>
        <xpath expr="//h2[contains(., 'Shipping Address')]" position="replace">
            <h2 class="o_page_header mt8">Direccion de envio</h2>
        </xpath>

        <xpath expr="//label[@for='name']" position="replace">
            <label class="col-form-label" for="name">Nombre y apellido</label>
        </xpath>
        <xpath expr="//label[@for='email']" position="replace">
            <label t-attf-class="col-form-label #{mode[1] == 'shipping' and 'label-optional' or ''}" for="email">Email</label>
        </xpath>
        <xpath expr="//label[@for='phone']" position="replace">
            <label class="col-form-label" for="phone">Telefono</label>
        </xpath>
        <xpath expr="//label[@for='street']" position="replace">
            <label class="col-form-label" for="street">Direccion</label>
        </xpath>
        <xpath expr="//label[@for='street2']" position="replace">
            <label class="col-form-label label-optional" for="street2">Complemento</label>
        </xpath>
        <xpath expr="//label[@for='city']" position="replace">
            <label class="col-form-label" for="city">Ciudad</label>
        </xpath>
        <xpath expr="//label[@for='zip']" position="replace">
            <label class="col-form-label label-optional" for="zip">Codigo postal</label>
        </xpath>
        <xpath expr="//label[@for='country_id']" position="replace">
            <label class="col-form-label" for="country_id">Pais</label>
        </xpath>
        <xpath expr="//label[@for='state_id']" position="replace">
            <label class="col-form-label" for="state_id">Provincia</label>
        </xpath>
        <xpath expr="//option[contains(., 'Country...')]" position="replace">
            <option value="">Pais...</option>
        </xpath>
        <xpath expr="//option[contains(., 'State / Province...')]" position="replace">
            <option value="">Provincia...</option>
        </xpath>
        <xpath expr="//label[input[@id='shipping_use_same']]" position="replace">
            <label>
                <input type="checkbox" id="shipping_use_same" class="mr8" name="use_same" value="1" checked="checked"/>Enviar a la misma direccion
                <span class="ship_to_other text-muted" style="display: none">&amp;nbsp;(<i>Solicitaremos la direccion de envio mas adelante</i>) </span>
            </label>
        </xpath>
        <xpath expr="//a[hasclass('btn-secondary') and hasclass('mb32')]/span" position="replace">
            <span>Volver</span>
        </xpath>
        <xpath expr="//a[hasclass('btn-primary') and hasclass('a-submit') and hasclass('mb32')]/span" position="replace">
            <span>Continuar</span>
        </xpath>
    </template>

    <template id="bader_address_on_payment" inherit_id="website_sale.address_on_payment"
              name="Bader Address on Payment" priority="30">
        <xpath expr="//a[@href='/shop/checkout' and hasclass('no-decoration')]" position="replace">
            <a class="float-end no-decoration" href="/shop/checkout">
                <i class="fa fa-edit"/> Editar
            </a>
        </xpath>
        <xpath expr="//b[contains(., 'Billing')]" position="replace">
            <b>Facturacion<t t-if="same_shipping and not only_services"> y envio</t>: </b>
        </xpath>
        <xpath expr="//b[contains(., 'Shipping:')]" position="replace">
            <b>Envio: </b>
        </xpath>
    </template>

    <template id="bader_payment_page" inherit_id="website_sale.payment"
              name="Bader Payment Page" priority="30">
        <xpath expr="//div[@id='wrap']/div[hasclass('container') and hasclass('oe_website_sale')]" position="attributes">
            <attribute name="class" add="bader-payment-page" separator=" "/>
        </xpath>
        <xpath expr="//h3[hasclass('mb24')]" position="replace">
            <h3 class="mb24">Selecciona metodo de pago</h3>
        </xpath>
        <xpath expr="//div[@id='payment_method' and not(@name)]" position="attributes">
            <attribute name="class" add="bader-payment-methods" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='payment_method' and not(@name)]/h3" position="after">
            <div class="bader-payment-trust">
                <span><i class="fa fa-lock"/> Pago seguro</span>
                <span><i class="fa fa-shield"/> Datos protegidos</span>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='payment.checkout']/t[@t-set='submit_button_label']" position="replace">
            <t t-set="submit_button_label">Pagar ahora</t>
        </xpath>
        <xpath expr="//div[@id='payment_method' and @name='o_website_sale_free_cart']//t[@t-set='submit_button_label']" position="replace">
            <t t-set="submit_button_label">Confirmar pedido</t>
        </xpath>
        <xpath expr="//div[hasclass('alert-warning') and strong]" position="replace">
            <div class="alert alert-warning">
                <strong>No encontramos un metodo de pago disponible.</strong><br/>
                Si crees que es un error, contacta al equipo de Bader.
            </div>
        </xpath>
    </template>

    <template id="bader_payment_footer" inherit_id="website_sale.payment_footer"
              name="Bader Payment Footer" priority="30">
        <xpath expr="//a[@href='/shop/cart' and hasclass('btn-secondary')]" position="replace">
            <a role="button" href="/shop/cart" class="btn btn-secondary bader-payment-back">
                <i class="fa fa-chevron-left"/> Volver al carrito
            </a>
        </xpath>
        <xpath expr="//button[@name='o_payment_submit_button']" position="attributes">
            <attribute name="class" add="bader-cart-cta" separator=" "/>
        </xpath>
    </template>

    <template id="bader_sale_confirmation_page" inherit_id="website_sale.confirmation"
              name="Bader Sale Confirmation Page" priority="30">
        <xpath expr="//div[@id='wrap']/div[hasclass('container') and hasclass('oe_website_sale')]" position="attributes">
            <attribute name="class" add="bader-confirmation-page" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='wrap']/div[hasclass('container') and hasclass('oe_website_sale')]/h1" position="replace">
            <h1 class="bader-confirmation-page__title">
                Pedido <em t-field="order.name"/> confirmado
            </h1>
        </xpath>

        <xpath expr="//div[hasclass('thanks_msg')]/h2" position="replace">
            <h2 class="bader-confirmation-page__subtitle">
                Gracias por tu compra.
                <a role="button"
                   class="btn btn-primary d-none d-md-inline-block"
                   href="/shop/print"
                   target="_blank"
                   aria-label="Imprimir"
                   title="Imprimir">
                    <i class="fa fa-print"/> Imprimir
                </a>
            </h2>
        </xpath>

        <xpath expr="//p[hasclass('alert-info') and @role='status']" position="replace">
            <p t-if="request.env['res.users']._get_signup_invitation_scope() == 'b2c' and request.website.is_public_user()"
               class="alert alert-info mt-3"
               role="status">
                <a role="button"
                   t-att-href="order.partner_id.signup_prepare() and order.partner_id.with_context(relative_url=True).signup_url"
                   class="btn btn-primary">Crear cuenta</a>
                para seguir el estado de tu pedido.
            </p>
        </xpath>

        <xpath expr="//h3[hasclass('text-start') and hasclass('mt-3')]/strong" position="replace">
            <strong>Informacion de pago:</strong>
        </xpath>

        <xpath expr="//table[hasclass('table')]" position="after">
            <div class="bader-confirmation-page__actions">
                <a href="/" class="btn-bader-outline">Volver al inicio</a>
                <a href="/productos" class="btn-bader">Seguir comprando</a>
            </div>
        </xpath>
    </template>

</odoo>
