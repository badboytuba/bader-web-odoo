<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bader_clerk_auth" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bader.clerk.auth</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Clerk Authentication" string="Clerk Authentication">
                    <h2>Clerk Authentication</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="clerk_publishable_key"/>
                                <div class="text-muted">Public key used by the Clerk browser SDK.</div>
                                <field name="clerk_publishable_key" password="True"/>
                                <field name="clerk_frontend_api"/>
                                <field name="clerk_jwks_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="clerk_secret_key"/>
                                <div class="text-muted">Backend credentials and provisioning behavior.</div>
                                <field name="clerk_secret_key" password="True"/>
                                <field name="clerk_webhook_signing_secret" password="True"/>
                                <field name="clerk_default_user_group"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
