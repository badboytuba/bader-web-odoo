<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        NOTE: All CSS + JS assets are registered via __manifest__.py 'assets' dict.
        This template kept empty intentionally to avoid double loading.
        The template ID must remain because it exists in the database from prior installs.
    -->
    <template id="clerk_auth_assets" inherit_id="web.assets_frontend" name="Clerk Auth Assets">
        <xpath expr="." position="inside">
            <!-- Assets loaded via __manifest__.py — no duplicates here -->
        </xpath>
    </template>
</odoo>
