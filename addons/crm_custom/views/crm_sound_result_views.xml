<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_sound_result_tree_view" model="ir.ui.view">
        <field name="model">crm.sound.result</field>
        <field name="arch" type="xml">
            <tree string="Sound Result" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="crm_sound_result_act" model="ir.actions.act_window">
        <field name="name">Sound Result</field>
        <field name="res_model">crm.sound.result</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
