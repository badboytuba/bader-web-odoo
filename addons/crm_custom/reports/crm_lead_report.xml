<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_crm_claim">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="company_logo" style="position:absolute;top:-50px;">
                            <img t-att-src="image_data_uri(o.company_id.logo)" style="max-width:300px;float:left;margin-top:0!important;"/>
                        </div>
                        <div class="company_data" style="margin-left:400px;">
                            <strong>
                                <span t-field="o.company_id.name"/>
                            </strong><br />
                            <span class="company_street" t-field="o.company_id.street"/><br />
                            <span class="company_street" t-field="o.company_id.zip" /> <span class="company_street" t-field="o.company_id.city"/><br />
                            <span class="company_street" t-field="o.company_id.email" /><br />
                            <strong><span class="phone_header">Phone: </span><span class="phone_header" t-field="o.company_id.phone"/></strong><br />
                        </div>
                        <br/><br/><br/><br/><br/>
                        <center><h2><span t-field="o.name"/></h2></center>
                        <center><h3>Number: <span t-field="o.code"/></h3></center>
                        <table class="table table-bordered">
                            <tr t-if="o.date">
                                <th>Date</th>
                                <td><span t-esc="o.date"/></td>
                            </tr>
                            <tr t-if="o.partner_id">
                                <th>Partner</th>
                                <td><span t-field="o.partner_id.name"/></td>
                            </tr>
                            <tr t-if="o.partner_phone">
                                <th>Phone</th>
                                <td><span t-field="o.partner_phone"/></td>
                            </tr>
                            <tr t-if="o.email_from">
                                <th>Email</th>
                                <td><span t-field="o.email_from"/></td>
                            </tr>
                            <tr t-if="o.alternative_contact_id">
                                <th>Alternative Contact</th>
                                <td><span t-field="o.alternative_contact_id.name"/></td>
                            </tr>
                            <tr t-if="o.categ_id">
                                <th>Category</th>
                                <td><span t-field="o.categ_id.display_name"/></td>
                            </tr>
                            <tr t-if="o.model_ref_id">
                                <th>Reference</th>
                                <td><span t-field="o.model_ref_id.name"/></td>
                            </tr>
                        </table>
                        <t t-if="o.description">
                            <center><h3>Description</h3></center>
                            <span t-field="o.description"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="bader_claim" model="report.paperformat">
        <field name="name">Bader Claim</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top" eval="10" />
        <field name="margin_bottom" eval="30" />
        <field name="margin_left" eval="15" />
        <field name="margin_right" eval="7" />
        <field name="header_line" eval="False" />
        <field name="header_spacing" eval="45" />
        <field name="dpi" eval="90" />
    </record>
</odoo>
