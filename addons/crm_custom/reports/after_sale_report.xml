<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="after_sale_report_document">
        <t t-call="web.basic_layout">
            <div class="after_sale">
                <t t-foreach="docs" t-as="o">
                    <center><span class="strong">BADER - Servicio Técnico</span></center>
                    <span class="strong">Code: </span><span class="strong" t-field="o.code"/><br/>
                    <span class="strong">Date: </span><t t-if="o.date"><span t-field="o.date" t-options="{'widget': 'date'}"/></t><br/>
                    <span class="strong">Costumer: </span><t t-if="o.partner_id"><span t-field="o.partner_id"/></t><br/>
                    <p style="page-break-after:always"/>
                </t>
            </div>
        </t>
    </template>
    <record id="crm_custom.paperformat_after_sale_report" model="report.paperformat">
        <field name="name">After Sale Report</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">33</field>
        <field name="page_width">53</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
