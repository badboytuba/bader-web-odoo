<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
            id="report_purchasequotation_document"
            inherit_id="purchase.report_purchasequotation_document"
            priority="9999"
    >
        <xpath expr="//th[@name='th_expected_date']" position="replace"/>
        <xpath expr="//span[@t-field='order_line.date_planned']/.." position="replace"/>
    </template>
    <template
            id="report_purchaseorder_document"
            inherit_id="purchase.report_purchaseorder_document"
            priority="9999"
    >
        <xpath expr="//th[@name='th_date_req']" position="replace"/>
        <xpath expr="//span[@t-field='line.date_planned']/.." position="replace"/>
    </template>
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="paperformat_id" ref="bader_custom.bader_a4" />
    </record>
    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="paperformat_id" ref="bader_custom.bader_a4" />
    </record>
</odoo>
