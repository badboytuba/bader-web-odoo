<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="repair.action_report_repair_order" model="ir.actions.report">
        <field name="paperformat_id" ref="bader_custom.bader_a4" />
        <field name="print_report_name">'Work Part - %s' % (object.name)</field>
    </record>
    <template
            id="report_repairorder"
            inherit_id="repair.report_repairorder"
            priority="9999"
    >
        <xpath expr="//div[@t-if='o.product_id.name']" position="after">
            <div class="col-3 bm-2">
                <strong>Schedule Date:</strong>
                <p t-field="o.schedule_date" class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//p[contains(@t-esc, 'datetime')]/.." position="replace"/>
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block">
                <div t-field="o.address_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
            </t>
        </xpath>
        <xpath expr="//h2" position="replace">
            <h2>
                <span>Work Part #:</span>
                <span t-field="o.name"/>
            </h2>
        </xpath>
    </template>
</odoo>
