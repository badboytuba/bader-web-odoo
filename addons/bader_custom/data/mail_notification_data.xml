<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <function model="ir.model.data" name="write">
            <value model="ir.model.data" search="[('name', '=', 'email_template_edi_sale'), ('module', '=', 'sale')]"/>
            <value eval="{'noupdate': False}" />
        </function>
        <record id="sale.email_template_edi_sale" model="mail.template">
            <field name="body_html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <t t-set="doc_name" t-value="'quotation' if object.state in ('draft', 'sent') else 'order'"/>
                        caca,
                        <br/><br/>
                        Your
                        <t t-if="ctx.get('proforma')">
                            Pro forma invoice for <t t-out="doc_name or ''">quotation</t> <span style="font-weight: bold;"  t-out="object.name or ''">S00052</span>
                            <t t-if="object.origin">
                                (with reference: <t t-out="object.origin or ''"/> )
                            </t>
                            amounting in <span style="font-weight: bold;"  t-out="format_amount(object.amount_total, object.pricelist_id.currency_id) or ''">$ 10.00</span> is available.
                        </t>
                        <t t-else="">
                            <t t-out="doc_name or ''">quotation</t> <span style="font-weight: bold;" t-out="object.name or ''"/>
                            <t t-if="object.origin">
                                (with reference: <t t-out="object.origin or ''">S00052</t> )
                            </t>
                            amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.pricelist_id.currency_id) or ''">$ 10.00</span> is ready for review.
                        </t>
                        <br/><br/>
                        Do not hesitate to contact us if you have any questions.
                        <t t-if="not is_html_empty(object.user_id.signature)">
                            <br/><br/>
                            <t t-out="object.user_id.signature or ''">
                                <br/><br/><br/>
                                <t t-out="object.user_id.signature or ''">
                                </t>
                                <br/><br/>
                                <br/><br/><br/>
                                <table width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #70D44B; margin-top: 10px;">
                                    <tr>
                                        <td style="padding: 14px;">
                                            <a href="https://bader.es" target="_blank">
                                                <!--<img src="https://lh3.googleusercontent.com/d/1BRcmH5ziYRDe9r6ydzQcdDIaQ6g-vEhA" alt="Bader Logo" style="display: block; height: 50px; border: 0;">-->
                                                <img src="data:image/png;base64," />
                                            </a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 14px; padding-bottom: 10px;">
                                            <a href="https://www.bader.es" target="_blank" style="color: white; text-decoration: none; font-size: 14px;"><b>bader.es</b></a>
                                        </td>
                                    </tr>
                                </table>

                                <table width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #70D44B; padding-top: 30px;">
                                    <tr>
                                        <td style="padding: 14px; font-size: 10px; color: #003841;">
                                            <strong>LEGAL NOTICE:</strong><br/>
                                            The information contained in this message and/or any attached file(s), sent from BADER EUROPE GROUP, SL, is confidential/privileged and intended to be read only by the person(s) to whom it is addressed. We remind you that your data has been incorporated into BADER EUROPE GROUP, SL's processing system, and, provided that the requirements established by regulations are met, you may exercise your rights of access, rectification, restriction of processing, erasure, portability, and objection/revocation, in accordance with the current data protection regulations, by sending your request to the postal address PORTO DO MOLLE, RÚA MADANELA, NAVE 3D - NIGRÁN (PONTEVEDRA) or via email at info@bader.es.
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 14px; font-size: 10px; color: #003841;">
                                            SIf you read this message and you are not the intended recipient, the employee, or the agent responsible for delivering the message to the recipient, or if you have received this communication in error, please be informed that any disclosure, distribution, or reproduction of this communication is strictly prohibited and may be illegal. We kindly ask you to notify us immediately and return the original message to the address mentioned above. Thank you.
                                        </td>
                                    </tr>
                                </table>
                            </t>
                        </t>
                    </p>
                </div>
            </field>
        </record>
        <function name="write" model="ir.model.data">
            <value model="ir.model.data" search="[('name', '=', 'email_template_edi_sale'), ('module', '=', 'sale')]"/>
            <value eval="{'noupdate': True}" />
        </function>
    </data>
</odoo>
