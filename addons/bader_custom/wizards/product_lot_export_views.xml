<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_lot_export_wizard" model="ir.ui.view">
        <field name="model">product.lot.export</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="internal_locations"/>
                    </group>
                </group>
                <footer>
                    <button
                            name="export_lots"
                            string="Export Lots"
                            type="object"
                            default_focus="1"
                            class="oe_highlight"
                    />
                    <button
                            string="Cancel"
                            class="btn btn-secondary"
                            special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>
    <record id="product_lot_export_action" model="ir.actions.act_window">
        <field name="name">Export Lots</field>
        <field name="res_model">product.lot.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
    </record>
</odoo>
