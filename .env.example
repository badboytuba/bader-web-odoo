QAS_SSH_USER=bader
QAS_SSH_PASSWORD=replace-me
QAS_DOMAIN=qas.bader.com.ar
QAS_DROPLET_ID=560070892

# Backward-compatible aliases for legacy scripts/tools
DEPLOY_HOST=24.199.111.94
DEPLOY_PORT=22
DEPLOY_USER=bader
DEPLOY_PASSWORD=replace-me

# Odoo deployment defaults for the QAS server
WEB_AUDIT_BASE_URL=https://qas.bader.com.ar
DEPLOY_REMOTE_ADDONS_PATH=/opt/odoo/src/bader
DEPLOY_REMOTE_STAGE_PATH=/home/bader/.cache/bader_deploy
DEPLOY_ODOO_PYTHON=/opt/odoo/.venv/bin/python
DEPLOY_ODOO_BIN=/opt/odoo/src/odoo/odoo-bin
DEPLOY_ODOO_CONFIG=/opt/odoo/conf/odoo-server.conf
DEPLOY_DB_NAME=bader
DEPLOY_SERVICE_NAME=odoo
DEPLOY_LOG_PATH=/var/log/odoo/odoo.log
DEPLOY_USE_SUDO=1

# GitHub repository
